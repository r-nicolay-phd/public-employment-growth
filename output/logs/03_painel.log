. mata:
------------------------------------------------- mata (type end to exit) -----
: void hp_panel(string scalar yv, string scalar idv, string scalar outv, real s
> calar lambda)
> {
>     real colvector y, id, out, sel, ys
>     real scalar i, n, T
>     real matrix D, A
>     st_view(y = ., ., yv)
>     st_view(id = ., ., idv)
>     out = J(rows(y), 1, .)
>     for (i = min(id); i <= max(id); i++) {
>         sel = selectindex((id :== i) :& (y :< .))
>         T = rows(sel)
>         if (T < 8) continue
>         ys = y[sel]
>         D = J(T - 2, T, 0)
>         for (n = 1; n <= T - 2; n++) D[n, (n, n + 1, n + 2)] = (1, -2, 1)
>         A = I(T) + lambda * D' * D
>         out[sel] = lusolve(A, ys)
>     }
>     st_store(., outv, out)
> }

: end
-------------------------------------------------------------------------------

