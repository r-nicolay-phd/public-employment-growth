 20.     save `P'
 21.     use "$FINAL/painel_anual.dta", clear
 22.     gen year0 = year + 1
 23.     keep id year0 lny
 24.     rename lny lny0
 25.     merge 1:1 id year0 using `P', keep(using match) nogen
 26.     * exige ao menos 3 de 5 (ou 2 de 3) anos de crescimento observados
.     replace g = . if ng < cond(`L' == 5, 3, 2)
 27.     gen year1 = year0 + `L' - 1
 28.     xtset id period
 29.     gen L_g = L.g
 30.     label var g "GDP per capita growth (%, period mean)"
 31.     label var L_g "Lagged GDP per capita growth (previous period)"
 32.     label var lny0 "Log initial GDP per capita"
 33.     label var wagebill_gdp0 "Wage bill (% of GDP), first year of period"
 34.     label var wagebill_gdp "Wage bill (% of GDP), period mean"
 35.     label var merit0 "Meritocratic recruitment (V-Dem), first year of peri
> od"
 36.     label var g_excr "GDP per capita growth excl. 2008-09 and 2020-21 (%, 
> period mean)"
 37.     compress
 38.     save "$FINAL/painel_`L'anos.dta", replace
 39. }
