. 
. capture confirm file "$INTERIM/fiscal_rules.dta"

. if _rc {
.     di "Fiscal Rules Dataset ausente: bloco H nao estimado"
.     log close
.     exit
. }

. 
. global X5 "lny0 hc0 inv open infl popg ctot_g"

. use "$FINAL/painel_5anos.dta", clear

. keep if micro == 0
(261 observations deleted)

. xtset id period

Panel variable: id (strongly balanced)
 Time variable: period, 0 to 8
         Delta: 1 unit

. 
. * regra em vigor no primeiro ano do periodo (como a folha); o modelo de cada 
> coluna usa nomes genericos
. * R0 (regra) e WBxR (folha x regra) para que os coeficientes fiquem na mesma 
> linha da tabela
. * membros da Uniao Europeia em algum momento de 1979-2023 (UE-27 e Reino Unid
> o): regra de resultado supranacional
. gen byte eu = inlist(iso3, "AUT", "BEL", "BGR", "HRV", "CYP", "CZE", "DNK", "
> EST", "FIN") | ///
>     inlist(iso3, "FRA", "DEU", "GRC", "HUN", "IRL", "ITA", "LVA", "LTU", "LUX
> ") | ///
>     inlist(iso3, "MLT", "NLD", "POL", "PRT", "ROU", "SVK", "SVN", "ESP", "SWE
> ") | iso3 == "GBR"

. local regras "rule_exp0 rule_bb0 rule_any0 rule_exp_nat0 rule_bb_nat0 rule_ex
> p0 rule_bb0"

. local amostras `""1" "1" "1" "1" "1" "in_frd == 1" "eu == 0""'

. local j = 0

. foreach r of local regras {
  2.     local ++j
  3.     local cond : word `j' of `amostras'
  4.     capture drop R0 WBxR
  5.     gen R0 = `r'
  6.     gen WBxR = wagebill_gdp0 * R0
  7.     reghdfe g wagebill_gdp0 R0 WBxR $X5 if `cond', absorb(id period) vce(c
> luster id)
  8.     estadd scalar nc = e(N_clust)
  9.     estadd scalar r2w = e(r2_within)
 10.     quietly lincom wagebill_gdp0 + WBxR
 11.     estadd scalar me1 = r(estimate)
 12.     estadd scalar me1_se = r(se)
 13.     estadd scalar me1_p = r(p)
 14.     * variacao que identifica a interacao: periodos com regra e paises que
>  mudam de status na amostra
.     tempvar s mx mn
 15.     gen byte `s' = e(sample)
 16.     quietly count if `s' & R0 == 1
 17.     estadd scalar nrule = r(N)
 18.     bysort id: egen `mx' = max(cond(`s', R0, .))
 19.     bysort id: egen `mn' = min(cond(`s', R0, .))
 20.     quietly egen _tg = tag(id) if `s' & `mx' != `mn'
 21.     quietly count if _tg == 1
 22.     estadd scalar nswitch = r(N)
 23.     drop _tg
 24.     estimates store H`j'
 25. }
