. * ---------------------------------------------------------------- Tabela 5
. local stars "* p<0.10, ** p<0.05, *** p<0.01."

. tab_new, ncol(3) head1("(1)" "(2)" "(3)") head2("Private investment" "TFP gro
> wth" "Private employment growth")

. tab_row "Panel A. Five-year averages (specification A1)" "" "" ""

. tab_est E1 E2 E3, keep(wagebill_gdp0)

. tab_stat N "Observations"

. tab_stat nc "Countries"

. tab_stat r2w "R2 (within)" %5.3f

. tab_mid

. tab_row "Panel B. Local projections (specification D1): cumulative response t
> o a real wage bill shock of 1% of GDP" "" "" ""

. foreach hh in 0 2 4 6 {
  2.     local rb ""
  3.     local rs ""
  4.     foreach e in E1 E2 E3 {
  5.         preserve
  6.         use "$INTERIM/lp_`e'.dta", clear
  7.         quietly keep if h == `hh'
  8.         local b = b[1]
  9.         local se = se[1]
 10.         local N = N[1]
 11.         local df = df[1]
 12.         restore
 13.         local p = 2 * ttail(`df', abs(`b' / `se'))
 14.         local st = cond(`p' < 0.01, "***", cond(`p' < 0.05, "**", cond(`p'
>  < 0.10, "*", "")))
 15.         local bs : display %6.3f `b'
 16.         local ss : display %6.3f `se'
 17.         local rb `"`rb' "`=strtrim("`bs'")'`st'""'
 18.         local rs `"`rs' "(`=strtrim("`ss'")')""'
 19.         local n_`e' `N'
 20.     }
 21.     tab_row "Horizon h = `hh'" `rb'
 22.     tab_row "" `rs'
 23. }

. tab_row "Observations (h = 0)" "`n_E1'" "`n_E2'" "`n_E3'"

. tab_out Table5_mechanisms, title("Table 5. Mechanisms: private investment, pr
> oductivity and private employment") ///
>     notes("Panel A: five-year averages, country and period fixed effects, sta
> ndard errors clustered by country; the wage bill (% of GDP) is measured in th
> e first year of the period; controls as in Table 2 (investment excluded in co
> lumn 1, where private investment is the outcome). Outcomes: private gross fix
> ed capital formation (% of GDP, IMF ICSD, available to 2019), TFP growth (PWT
>  11.0, rtfpna), growth of private employment (total minus public employment f
> rom the same ILOSTAT survey). Panel B: annual local projections, 1996-2023: r
> esponse at horizon h of the outcome level (private investment in p.p. of GDP;
>  100 x log TFP; 100 x log private employment) relative to t-1, to a real wage
>  bill increase of 1% of lagged GDP, with two lags of the shock and of GDP per
>  capita growth, country and year fixed effects and Driscoll-Kraay standard er
> rors. `stars'")
