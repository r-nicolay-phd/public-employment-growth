. * ---------------------------------------------------------------- utilitario
> s
. capture program drop pt

. program define pt, rclass
  1.     * pt valor [formato] -> r(s): numero com virgula decimal
.     args x f
  2.     if "`f'" == "" local f %6.3f
  3.     if missing(`x') {
  4.         return local s "–"
  5.         exit
  6.     }
  7.     local s : display `f' `x'
  8.     local s = strtrim("`s'")
  9.     local s = subinstr("`s'", ".", ",", .)
 10.     return local s "`s'"
 11. end

. 
. capture program drop cf

. program define cf
  1.     * cf estimativa variavel prefixo -> globals prefixo_b, _se, _lo, _hi, 
> _p (texto) e prefixo_bn, _pn (numeros)
.     args est v px
  2.     quietly estimates use "$LOG/est_`est'"
  3.     local b = _b[`v']
  4.     local se = _se[`v']
  5.     local df = e(df_r)
  6.     if missing(`df') local q = invnormal(0.975)
  7.     else local q = invttail(`df', 0.025)
  8.     if missing(`df') local p = 2 * normal(-abs(`b' / `se'))
  9.     else local p = 2 * ttail(`df', abs(`b' / `se'))
 10.     global `px'_bn = `b'
 11.     global `px'_pn = `p'
 12.     pt `b'
 13.     global `px'_b "`r(s)'"
 14.     pt `se'
 15.     global `px'_se "`r(s)'"
 16.     pt `=`b' - `q' * `se''
 17.     global `px'_lo "`r(s)'"
 18.     pt `=`b' + `q' * `se''
 19.     global `px'_hi "`r(s)'"
 20.     pt `p' %5.3f
 21.     global `px'_p "`r(s)'"
 22.     global `px'_N = e(N)
 23.     global `px'_ci "[${`px'_lo}; ${`px'_hi}]"
 24. end

. 
. capture program drop verd

. program define verd
  1.     * verd prefixo sinal(-1/+1) -> global prefixo_v
.     args px sg
  2.     local b = ${`px'_bn}
  3.     local p = ${`px'_pn}
  4.     if `p' < 0.05 & sign(`b') == `sg' global `px'_v "sustentada"
  5.     else if `p' < 0.05 & sign(`b') == -`sg' global `px'_v "rejeitada"
  6.     else if `p' < 0.10 & sign(`b') == `sg' global `px'_v "inconclusiva (ev
> idência fraca, p < 0,10)"
  7.     else global `px'_v "inconclusiva"
  8. end

