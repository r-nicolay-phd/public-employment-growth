. local labs `""Governo central (WDI, série da dissertação)" "Governo geral ou 
> central (série combinada)" "Com microestados" "Sem países ricos em recursos n
> aturais" "Sem 2008–2009 e 2020–2021" "Sem winsorização" "Controle de dívida p
> ública" "Renda baixa (1996)" "Renda média-baixa" "Renda média-alta" "Renda al
> ta" "OCDE" "Fora da OCDE" "Federais" "Unitários" "CCE de grupo médio (anual, 
> folha defasada)""'

. local mods G_cg_wdi G_comb G_micro G_noresource G_nocrisis G_nowins G_debt G_
> inc1 G_inc2 G_inc3 G_inc4 G_oecd G_nonoecd G_federal G_unitary G_cce

. local nflip 0

. local nloss 0

. local i 0

. foreach m of local mods {
  2.     local ++i
  3.     local l : word `i' of `labs'
  4.     cf `m' wagebill_gdp0 rr
  5.     local sit "mantém sinal e significância"
  6.     if $rr_bn > 0 & $rr_pn < 0.10 {
  7.         local sit "**muda de sinal (significativo)**"
  8.         local ++nflip
  9.     }
 10.     else if $rr_bn > 0 {
 11.         local sit "**muda de sinal (não significativo)**"
 12.         local ++nflip
 13.     }
 14.     else if $rr_pn >= 0.10 {
 15.         local sit "**perde significância**"
 16.         local ++nloss
 17.     }
 18.     else if $rr_pn >= 0.05 local sit "mantém sinal; p entre 0,05 e 0,10"
 19.     file write `R' "| `l' | $rr_b | $rr_se | $rr_p | $rr_N | `sit' |" _n
 20. }

