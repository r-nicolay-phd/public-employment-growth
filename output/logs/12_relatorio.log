. file write `R' "# Table and figure captions" _n _n "Generated by \`code/12_re
> latorio.do\`. Table titles and notes are identical to those in the table file
> s." _n _n

. file write `R' "## Tables" _n _n

. local tabs Table1_descriptives Table2_baseline Table3_decomposition Table4_mo
> deration Table5_mechanisms Table6_political_economy ///
>     TableA1_definitions TableA2_countries TableA3_correlations TableA4_gmm_in
> struments TableA5_bond_check TableA6_threshold ///
>     TableA7_denominator TableA8a_robustness_definitions TableA8b_robustness_s
> ubsamples TableA8c_robustness_cce TableA9_bma

. foreach t of local tabs {
  2.     tempname C
  3.     capture file open `C' using "$LOG/captions/`t'.txt", read text
  4.     if _rc continue
  5.     file read `C' ttl
  6.     file read `C' nts
  7.     file close `C'
  8.     file write `R' "**`ttl'**" _n _n
  9.     if `"`nts'"' != "" file write `R' `"*Notes:* `nts'"' _n _n
 10. }

