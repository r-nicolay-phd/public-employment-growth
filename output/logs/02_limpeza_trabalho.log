. * ---------------------------------------------------------------- ILOSTAT
. * varias fontes (pesquisas) por pais-ano: prioridade LFS > estimativas oficia
> is > outras; dentro da
. * mesma classe, a fonte com mais anos no pais (serie mais longa e homogenea)
. foreach f in EMP_PUBL_SEX_AGE_NB EMP_TEMP_SEX_AGE_NB EAR_PMTA_SEX_NB {
  2.     import delimited "$RAW/ilostat/`f'.csv", clear varnames(1) case(lower)
>  encoding(utf8) bindquote(strict)
  3.     rename (ref_area time_period obs_value) (iso3 year value)
  4.     keep if !missing(value) & freq == "A"
  5.     capture confirm string variable year
  6.     if !_rc {
  7.         destring year, replace force
  8.         drop if missing(year)
  9.     }
 10.     if "`f'" == "EAR_PMTA_SEX_NB" keep if unit_measure == "LC" | missing(u
> nit_measure)
 11.     gen byte prio = cond(substr(source, 1, 3) == "LFS", 1, cond(substr(sou
> rce, 1, 2) == "OE", 2, 3))
 12.     bysort iso3 source: gen nyrs = _N
 13.     gsort iso3 year prio -nyrs source
 14.     by iso3 year: keep if _n == 1
 15.     gen str src_`f' = source
 16.     keep iso3 year value src_`f'
 17.     rename value v_`f'
 18.     tempfile t_`f'
 19.     save `t_`f''
 20. }
