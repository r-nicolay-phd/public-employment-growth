. * ---------------------------------------------------------------- A5. System
>  GMM (Blundell-Bond)
. * Crescimento defasado (L_g = crescimento medio do periodo anterior), folha i
> nicial, investimento e renda
. * inicial tratados como endogenos; capital humano, abertura, inflacao, popula
> cao, termos de troca e dummies
. * de periodo como instrumentos padrao. Instrumentos colapsados; defasagens 2-
> 3 (L_g: 1-2, que sao as
. * defasagens 2-3 de g); dois estagios com correcao de Windmeijer.
. local exo "hc0 open infl popg ctot_g"

. quietly tab period, gen(pd)

. drop pd1

. local gmmset1 "gmm(L_g, lag(1 1) collapse) gmm(wagebill_gdp0 inv lny0, lag(2 
> 2) collapse)"

. local gmmset2 "gmm(L_g, lag(1 2) collapse) gmm(wagebill_gdp0 inv lny0, lag(2 
> 3) collapse)"

. local gmmset3 "gmm(L_g, lag(1 3) collapse) gmm(wagebill_gdp0 inv lny0, lag(2 
> 4) collapse)"

. forvalues s = 1/3 {
  2.     xtabond2 g L_g wagebill_gdp0 $X5 pd*, `gmmset`s'' iv(`exo' pd*) twoste
> p robust small
  3.     estadd scalar nc = e(N_g)
  4.     estadd scalar nins = e(j)
  5.     estadd scalar ratio_ins = e(j) / e(N_g)
  6.     matrix DH = e(diffsargan)
  7.     estadd scalar dhansenp = DH[5, 1]
  8.     di "Conjunto `s': instrumentos = " e(j) ", paises = " e(N_g) ", AR(2) 
> p = " %5.3f e(ar2p) ", Hansen p = " %5.3f e(hansenp) ", dif-Hansen (nivel) p 
> = " %5.3f DH[5, 1]
  9.     assert e(j) < e(N_g) / 2
 10.     estimates store A5_s`s'
 11. }
