. capture program drop fig_export

. program define fig_export
  1.     * fig_export nome, width(90|190) height(mm)
.     syntax anything(name=fname), width(integer) height(integer)
  2.     local fname `fname'
  3.     local win = `width' / 25.4
  4.     local hin = `height' / 25.4
  5.     graph display, xsize(`win') ysize(`hin')
  6.     graph export "$FIG/`fname'.pdf", replace
  7.     local px = round(`win' * 600)
  8.     graph export "$FIG/`fname'.png", replace width(`px')
  9.     di as text "figura gravada: $FIG/`fname'.{pdf,png} (`width' x `height'
>  mm)"
 10. end

. 
end of do-file

