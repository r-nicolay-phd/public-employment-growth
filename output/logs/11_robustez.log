. capture program drop tab_out

. program define tab_out
  1.     syntax anything(name=fname), title(string) [notes(string) landscape co
> lwidth(string)]
  2.     local fname `fname'
  3.     mata: _tab_tex("$TAB/`fname'.tex", `"`title'"', `"`notes'"', "`fname'"
> )
  4.     * docx
.     mata: st_local("nr", strofreal(rows(TABH) + rows(TAB))); st_local("nc", s
> trofreal(cols(TAB)))
  5.     putdocx clear
  6.     putdocx begin, pagesize(A4) `=cond("`landscape'" != "", "landscape", "
> ")' font("Times New Roman", 10)
  7.     putdocx paragraph, spacing(after, 4pt)
  8.     putdocx text (`"`title'"'), bold
  9.     putdocx table T = (`nr', `nc'), border(all, nil) border(top, single) b
> order(bottom, single) layout(autofitcontents)
 10.     mata: _tab_docx()
 11.     if `"`notes'"' != "" {
 12.         putdocx paragraph, spacing(before, 4pt)
 13.         putdocx text (`"Notes: `notes'"'), font("Times New Roman", 9)
 14.     }
 15.     putdocx save "$TAB/`fname'.docx", replace
 16.     * registro de legenda e nota (compilado em output/captions.md por 12_r
> elatorio.do)
.     tempname C
 17.     file open `C' using "$LOG/captions/`fname'.txt", write replace text
 18.     file write `C' `"`title'"' _n `"`notes'"' _n
 19.     file close `C'
 20.     di as text "tabela gravada: $TAB/`fname'.{tex,docx}"
 21. end

