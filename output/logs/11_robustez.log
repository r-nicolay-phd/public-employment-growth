. mata:
------------------------------------------------- mata (type end to exit) -----
: string rowvector _untok(string rowvector t)
> {
>     real scalar i
>     string scalar x
>     for (i = 1; i <= cols(t); i++) {
>         x = t[i]
>         if (substr(x, 1, 2) == char(96) + char(34) & substr(x, -2, 2) == char
> (34) + char(39)) x = substr(x, 3, strlen(x) - 4)
>         else if (substr(x, 1, 1) == char(34) & substr(x, -1, 1) == char(34)) 
> x = substr(x, 2, strlen(x) - 2)
>         t[i] = x
>     }
>     return(t)
> }

: 
: void _tab_addrow(string scalar lab, string scalar cells)
> {
>     external string matrix TAB
>     string rowvector c
>     real scalar k
>     c = _untok(tokens(cells))
>     if (cols(c) == 0) c = J(1, cols(TAB) - 1, "")
>     k = cols(TAB) - 1
>     if (cols(c) < k) c = c, J(1, k - cols(c), "")
>     TAB = TAB \ (lab, c[1..k])
> }

: 
: string scalar _texesc(string scalar s, | real scalar nostars)
> {
>     string scalar r
>     r = subinstr(s, "\", "\textbackslash{}")
>     r = subinstr(r, "%", "\%")
>     r = subinstr(r, "&", "\&")
>     r = subinstr(r, "_", "\_")
>     r = subinstr(r, "#", "\#")
>     r = subinstr(r, "$", "\$")
>     r = subinstr(r, "R2", "\$R^2\$")
>     if (nostars == 1) return(r)
>     r = subinstr(r, "***", "\sym{***}")
>     r = subinstr(r, "**}", "**}")
>     if (strpos(r, "\sym{***}") == 0) {
>         r = subinstr(r, "**", "\sym{**}")
>         if (strpos(r, "\sym{**}") == 0) r = subinstr(r, "*", "\sym{*}")
>     }
>     return(r)
> }

: 
: void _tab_tex(string scalar fn, string scalar title, string scalar notes, str
> ing scalar lbl)
> {
>     external string matrix TAB, TABH
>     external real colvector TABMID
>     real scalar fh, i, j, k
>     string scalar line
>     k = cols(TAB)
>     if (fileexists(fn)) unlink(fn)
>     fh = fopen(fn, "w")
>     fput(fh, "% gerado por code/00_tabelas.do -- nao editar a mao")
>     fput(fh, "\begin{table}[htbp]\centering\footnotesize")
>     fput(fh, "\providecommand{\sym}[1]{\ensuremath{^{#1}}}")
>     fput(fh, "\caption{" + _texesc(title) + "}\label{tab:" + lbl + "}")
>     fput(fh, "\begin{tabular}{l*{" + strofreal(k - 1) + "}{c}}")
>     fput(fh, "\toprule")
>     for (i = 1; i <= rows(TABH); i++) {
>         line = _texesc(TABH[i, 1])
>         for (j = 2; j <= k; j++) line = line + " & " + _texesc(TABH[i, j])
>         fput(fh, line + " \\")
>     }
>     if (rows(TABH) > 0) fput(fh, "\midrule")
>     for (i = 1; i <= rows(TAB); i++) {
>         line = _texesc(TAB[i, 1])
>         for (j = 2; j <= k; j++) line = line + " & " + _texesc(TAB[i, j])
>         fput(fh, line + " \\")
>         if (anyof(TABMID, i)) fput(fh, "\midrule")
>     }
>     fput(fh, "\bottomrule")
>     fput(fh, "\end{tabular}")
>     if (notes != "") {
>         fput(fh, "\begin{minipage}{0.95\linewidth}\vspace{4pt}\scriptsize \te
> xtit{Notes:} " + _texesc(notes, 1) + "\end{minipage}")
>     }
>     fput(fh, "\end{table}")
>     fclose(fh)
> }

: 
: void _tab_docx()
> {
>     external string matrix TAB, TABH
>     external real colvector TABMID
>     real scalar i, j, r, h
>     string scalar cmd, txt
>     h = rows(TABH)
>     for (i = 1; i <= h + rows(TAB); i++) {
>         for (j = 1; j <= cols(TAB); j++) {
>             txt = (i <= h ? TABH[i, j] : TAB[i - h, j])
>             if (txt == "") continue
>             txt = subinstr(txt, `"""', "'")
>             txt = subinstr(txt, "R2", "R" + uchar(178))
>             cmd = "putdocx table T(" + strofreal(i) + "," + strofreal(j) + ")
>  = (" + char(96) + char(34) + txt + char(34) + char(39) + ")"
>             if (j > 1) cmd = cmd + ", halign(center)"
>             stata(cmd)
>         }
>         if (i == h & h > 0) stata("putdocx table T(" + strofreal(i) + ",.), b
> order(bottom, single)")
>         if (i > h) {
>             if (anyof(TABMID, i - h)) stata("putdocx table T(" + strofreal(i)
>  + ",.), border(bottom, single)")
>         }
>     }
> }
note: variable r unused.

: end
