. * xtdcce2 limpa a memoria do Mata: recarrega as funcoes de tabela
. do "$ROOT/code/00_tabelas.do"

. * 00_tabelas.do -- utilitarios de tabelas e figuras para publicacao (chamado 
> por 00_setup.do)
. *
. * Fluxo das tabelas:
. *   1) tab_new                         -- zera a grade de strings (Mata: TAB)
. *   2) tab_est m1 m2 ..., keep() ...   -- coeficientes, EP entre parenteses e
>  estrelas a partir de estimativas
. *      ou tab_row "rotulo" "c1" "c2"   -- linha livre (estatisticas descritiv
> as, testes)
. *   3) tab_stat nome "rotulo" fmt      -- linha de estatistica e(nome) de cad
> a modelo
. *   4) tab_out arquivo, title() notes() -- grava output/tables/arquivo.tex e 
> .docx
. * Rotulos legiveis das variaveis vem de globals LBL_<nome> (definidos em code
> /00_rotulos.do).
. 
. capture program drop tab_new

. program define tab_new
  1.     syntax , ncol(integer) [head1(string asis) head2(string asis)]
  2.     mata: TAB = J(0, `ncol' + 1, ""); TABH = J(0, `ncol' + 1, ""); TABMID 
> = J(0, 1, .)
  3.     if `"`head1'"' != "" mata: TABH = TABH \ ("" , _untok(tokens(`"`head1'
> "')))
  4.     if `"`head2'"' != "" mata: TABH = TABH \ ("" , _untok(tokens(`"`head2'
> "')))
  5.     global TAB_MODELS ""
  6. end

. 
. capture program drop tab_row

. program define tab_row
  1.     * tab_row "rotulo" "c1" "c2" ...  (celulas vazias "" sao preservadas)
.     gettoken lab rest : 0
  2.     local cells ""
  3.     while `"`rest'"' != "" {
  4.         gettoken c rest : rest
  5.         local cells `"`cells' `"`c'"'"'
  6.     }
  7.     mata: _tab_addrow(`"`lab'"', `"`cells'"')
  8. end

