. capture program drop tab_est

. program define tab_est
  1.     syntax namelist, keep(string) [dec(integer 3) noSE]
  2.     global TAB_MODELS "`namelist'"
  3.     foreach v of local keep {
  4.         local lab "${LBL_`v'}"
  5.         if "`lab'" == "" local lab "`v'"
  6.         local brow ""
  7.         local srow ""
  8.         foreach m of local namelist {
  9.             quietly estimates restore `m'
 10.             local vv `v'
 11.             * xtdpdbc nomeia a defasada como L.g; demais estimadores usam 
> a variavel L_g
.             if "`v'" == "L_g" {
 12.                 capture local b = _b[L_g]
 13.                 if _rc local vv L.g
 14.             }
 15.             * exige nome exato (o _b[] do Stata aceita abreviacoes)
.             local cnames : colnames e(b)
 16.             local found : list vv in cnames
 17.             capture local b = _b[`vv']
 18.             local miss = (_rc != 0) | !`found'
 19.             if !`miss' local miss = missing(`b') | (`b' == 0 & _se[`vv'] =
> = 0)
 20.             if `miss' {
 21.                 local brow `"`brow' """'
 22.                 local srow `"`srow' """'
 23.                 continue
 24.             }
 25.             local sev = _se[`vv']
 26.             local df = e(df_r)
 27.             if missing(`df') local p = 2 * normal(-abs(`b' / `sev'))
 28.             else local p = 2 * ttail(`df', abs(`b' / `sev'))
 29.             local st = cond(`p' < 0.01, "***", cond(`p' < 0.05, "**", cond
> (`p' < 0.10, "*", "")))
 30.             local bs : display %12.`dec'f `b'
 31.             local ss : display %12.`dec'f `sev'
 32.             local bs = strtrim("`bs'")
 33.             local ss = "(" + strtrim("`ss'") + ")"
 34.             local brow `"`brow' "`bs'`st'""'
 35.             local srow `"`srow' "`ss'""'
 36.         }
 37.         mata: _tab_addrow(`"`lab'"', `"`brow'"')
 38.         if "`se'" != "nose" mata: _tab_addrow("", `"`srow'"')
 39.     }
 40. end

. 
. capture program drop tab_stat

. program define tab_stat
  1.     * tab_stat escalar "rotulo" formato   (escalar de e(); ausente fica em
>  branco)
.     args sc lab fmt
  2.     if "`fmt'" == "" local fmt "%9.0fc"
  3.     local row ""
  4.     foreach m of global TAB_MODELS {
  5.         quietly estimates restore `m'
  6.         local x = e(`sc')
  7.         if missing(`x') local row `"`row' """'
  8.         else {
  9.             local s : display `fmt' `x'
 10.             local row `"`row' "`=strtrim("`s'")'""'
 11.         }
 12.     }
 13.     mata: _tab_addrow(`"`lab'"', `"`row'"')
 14. end

