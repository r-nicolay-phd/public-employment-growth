. 
. global X5 "lny0 hc0 inv open infl popg ctot_g"

. use "$FINAL/painel_5anos.dta", clear

. xtset id period

Panel variable: id (strongly balanced)
 Time variable: period, 0 to 8
         Delta: 1 unit

. 
. capture program drop rob

. program define rob
  1.     * rob nome "if" [depvar] [wbvar] [extra]
.     args nm cond dep wb extra
  2.     if "`dep'" == "" local dep g
  3.     if "`wb'" == "" local wb wagebill_gdp0
  4.     local Xg "$X5"
  5.     if "`dep'" == "g_raw" local Xg : subinstr local Xg "infl" "infl_raw"
  6.     reghdfe `dep' wagebill_gdp0 `Xg' `extra' if `cond', absorb(id period) 
> vce(cluster id)
  7.     estadd scalar nc = e(N_clust)
  8.     estadd scalar r2w = e(r2_within)
  9.     estimates store G_`nm'
 10. end

. 
