> ão editar à mão: todo número abaixo sai do código." _n _n

. 
. * --- regras de limpeza
. file write `A' "## 1. Regras de limpeza (na ordem aplicada)" _n _n

. file write `A' "| Regra | Descrição | Países | Obs. país-ano 1996–2023 (R4: 1
> 980–2023) | Obs. com folha |" _n "|---|---|---|---|---|" _n

. preserve

. import delimited "$LOG/regras_limpeza.csv", clear varnames(1) stringcols(_all
> ) delimiters(",")
(encoding automatically selected: ISO-8859-1)
(5 vars, 7 obs)

. forvalues i = 1/`=_N' {
  2.     file write `A' "| " (regra[`i']) " | " (descricao[`i']) " | " (paises[
> `i']) " | " (obs_pais_ano[`i']) " | " (obs_folha[`i']) " |" _n
  3. }

. restore

. file write `A' _n "Observações eliminadas pela regra 3 (folha acima de 30% do
>  PIB ou despesa acima de 100% do PIB, valores do GFS antes da regra): Irã 198
> 6–1989 (folha de 34% a 41% do PIB no GFS contra 9% a 12% do PIB na série de g
> overno central do WDI, erro de fonte evidente), Ilhas Marshall 2009, Nauru 20
> 15–2023 e Timor-Leste 2010–2012, 2016, 2021–2022 (despesa acima de 100% do PI
> B, financiada por fundos de recursos naturais ou doações). Ilhas Marshall e N
> auru são microestados e já estavam fora da amostra principal. A lista complet
> a está em \`output/logs/03_painel.log\`." _n _n

. 
. * --- amostras
. use "$FINAL/painel_anual.dta", clear

. gen byte main = micro == 0 & inrange(year, 1996, 2023)

. file write `A' "## 2. Tamanho das amostras" _n _n

. file write `A' "| Amostra | Países | Observações |" _n "|---|---|---|" _n

. local labs `""Anual, folha GG, 1996–2023, sem microestados (principal)" "Anua
> l, folha GG, com microestados" "Anual, folha GG ou GC (série combinada), sem 
> microestados" "Anual, folha GC (WDI, como na dissertação), sem microestados""
> '

. local conds `""main & !missing(wagebill_gdp)" "inrange(year,1996,2023) & !mis
> sing(wagebill_gdp)" "main & !missing(wagebill_comb)" "main & !missing(wagebil
> l_cg_wdi)""'

. forvalues j = 1/4 {
  2.     local c : word `j' of `conds'
  3.     local l : word `j' of `labs'
  4.     quietly count if `c'
  5.     local n = r(N)
  6.     quietly levelsof id if `c'
  7.     file write `A' "| `l' | `: word count `r(levels)'' | `n' |" _n
  8. }

. foreach s in "income_grp == 1" "income_grp == 2" "income_grp == 3" "income_gr
> p == 4" "oecd == 1" "oecd == 0" "federal == 1" "federal == 0" "resource_rich 
> == 1" "resource_rich == 0" {
  2.     quietly count if main & !missing(wagebill_gdp) & `s'
  3.     local n = r(N)
  4.     quietly levelsof id if main & !missing(wagebill_gdp) & `s'
  5.     file write `A' "| Anual, folha GG, subamostra \`" "`s'" "\` | `: word 
> count `r(levels)'' | `n' |" _n
  6. }

. foreach L in 5 3 {
  2.     preserve
  3.     use "$FINAL/painel_`L'anos.dta", clear
  4.     quietly count if micro == 0 & !missing(g, wagebill_gdp0)
  5.     local n = r(N)
  6.     quietly levelsof id if micro == 0 & !missing(g, wagebill_gdp0)
  7.     file write `A' "| Médias de `L' anos, folha GG no 1º ano, sem microest
> ados | `: word count `r(levels)'' | `n' |" _n
  8.     restore
  9. }

. file write `A' _n

. 
