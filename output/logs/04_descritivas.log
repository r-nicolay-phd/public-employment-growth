. foreach c in BRA USA DEU IND ARG MEX CAN FRA ZAF IDN {
  2.     local r "| `c'"
  3.     foreach v in wagebill_gdp wagebill_cg_wdi wagebill_cg_gfs wwbi_wagebil
> l_gdp wagebill_eurostat {
  4.         quietly summ `v' if iso3 == "`c'" & inrange(year, 2010, 2019)
  5.         if r(N) == 0 local r "`r' | –"
  6.         else local r "`r' | `: display %5.1f r(mean)'"
  7.         if "`v'" == "wagebill_gdp" local gg = r(mean)
  8.         if "`v'" == "wagebill_cg_wdi" local cg = r(mean)
  9.     }
 10.     if missing(`gg') | missing(`cg') local r "`r' | –"
 11.     else local r "`r' | `: display %4.1f `gg' / `cg''"
 12.     file write `A' "`r' |" _n
 13. }

. file write `A' _n "Nos países federais (Brasil, Estados Unidos, Alemanha, Índ
> ia, Argentina, México, Canadá), a série de governo central do WDI usada na di
> ssertação capta só uma fração da folha do governo geral. A diferença é menor 
> em países unitários." _n _n

. 
. * --- verificacao da decomposicao
. file write `A' "## 6. Verificação da decomposição da folha" _n _n

. quietly gen double _chk = abs(pubemp_share * relwage - wagebill_gdp)

. quietly summ _chk if main

. file write `A' "- \`relwage\` = folha (% do PIB, GFS) / emprego público (% do
>  emprego total, WWBI). O produto \`pubemp_share × relwage\` reproduz \`wagebi
> ll_gdp\` com discrepância máxima de `: display %9.2e r(max)' pontos percentua
> is em `r(N)' observações; a identidade é algébrica por construção, pois o mes
> mo emprego total entra no numerador e no denominador." _n

. quietly summ ratio_ilo_gfs if main, detail

. file write `A' "- Verificação com fonte independente: a folha implícita no IL
> OSTAT (salário médio mensal dos empregados públicos × 12 × emprego público, %
>  do PIB) dividida pela folha do GFS tem mediana `: display %4.2f r(p50)' (p25
>  = `: display %4.2f r(p25)', p75 = `: display %4.2f r(p75)', `r(N)' observaçõ
> es). Valores abaixo de 1 são esperados: o salário do ILOSTAT exclui contribui
> ções sociais do empregador, que fazem parte da remuneração de empregados no G
> FS, e as pesquisas domiciliares cobrem mal os níveis subnacionais." _n

. quietly correlate wwbi_wagebill_gdp wagebill_gdp if main

. file write `A' "- Folha do WWBI contra folha do GFS: correlação `: display %4
> .2f r(rho)' em `r(N)' observações (o WWBI combina fontes de governo central e
>  geral conforme o país)." _n _n

. 
. * --- downloads
. file write `A' "## 7. Downloads que falharam" _n _n

. file write `A' "Ver \`docs/DOWNLOADS_MANUAIS.md\`. Falha registrada pelo scri
> pt de coleta (\`data/raw/_falhas.txt\`):" _n _n

. capture confirm file "$RAW/_falhas.txt"

. local nf 0

. if !_rc {
.     tempname F
.     file open `F' using "$RAW/_falhas.txt", read text
.     file read `F' line
.     while r(eof) == 0 {
  2.         if "`line'" != "" {
  3.             file write `A' "- `line'" _n
  4.             local ++nf
  5.         }
  6.         file read `F' line
  7.     }
.     file close `F'
. }

. capture confirm file "$INTERIM/fiscal_rules.dta"

. local frok = !_rc

. if `nf' == 0 & `frok' file write `A' "- Nenhuma falha nas fontes automáticas.
>  O FMI Fiscal Rules Dataset (atualização 1985–2024) foi obtido por download m
> anual (o servidor bloqueia acesso automatizado); 123 países listados, membros
>  do FMI ausentes codificados sem regra; 1979–1984 reconstruídos pelo ano de i
> mplementação (decisão D38)." _n

. if `nf' == 0 & !`frok' file write `A' "- Nenhuma falha nas fontes automáticas
> . Pendente apenas o FMI Fiscal Rules Dataset (bloqueio do servidor; download 
> manual)." _n

. file close `A'

. 
