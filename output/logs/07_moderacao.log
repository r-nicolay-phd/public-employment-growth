. * estimador por kernel (HMX 2019) implementado aqui: o modo kernel do interfl
> ex com efeitos fixos e
. * bootstrap termina com erro de sintaxe interno (ver docs/DECISOES.md, D28). 
> Banda escolhida pela validacao
. * cruzada do proprio interflex (0,4701); regressao local ponderada (kernel ga
> ussiano) de g em folha,
. * (merit0 - x0), folha x (merit0 - x0) e controles, com EF de pais e periodo;
>  IC por bootstrap por pais.
. local bw = 0.4701

. quietly summ merit0 if sC1

. local kmin = r(min)

. local kmax = r(max)

. local neval = 30

. tempname K

. postfile `K' double(km_x km_me km_se km_lo km_hi) using "$INTERIM/me_kernel.d
> ta", replace

. forvalues v = 1/`neval' {
  2.     local x0 = `kmin' + (`v' - 1) * (`kmax' - `kmin') / (`neval' - 1)
  3.     capture drop _xx _dx _w
  4.     quietly gen double _xx = merit0 - `x0'
  5.     quietly gen double _dx = _xx * wagebill_gdp0
  6.     quietly gen double _w = normalden(_xx / `bw')
  7.     quietly reghdfe g wagebill_gdp0 _xx _dx $X5 [aw = _w] if sC1, absorb(i
> d period)
  8.     local me = _b[wagebill_gdp0]
  9.     * bootstrap por pais (200 replicacoes)
.     tempname B
 10.     postfile `B' double bb using "$INTERIM/_kb.dta", replace
 11.     forvalues r = 1/200 {
 12.         preserve
 13.         quietly keep if sC1
 14.         bsample, cluster(id) idcluster(bid)
 15.         capture quietly reghdfe g wagebill_gdp0 _xx _dx $X5 [aw = _w], abs
> orb(bid period)
 16.         if !_rc post `B' (_b[wagebill_gdp0])
 17.         restore
 18.     }
 19.     postclose `B'
 20.     preserve
 21.     use "$INTERIM/_kb.dta", clear
 22.     quietly summ bb
 23.     local kse = r(sd)
 24.     restore
 25.     post `K' (`x0') (`me') (`kse') (`me' - 1.96 * `kse') (`me' + 1.96 * `k
> se')
 26. }

. postclose `K'

. capture drop _xx _dx _w

