. * dados da Figura 3 e Tabela A7
. tempname F

. postfile `F' str20 spec str60 label double(b se lo hi) int(N nc) using "$INTE
> RIM/d4.dta", replace

. local i = 0

. foreach v in wb_contemp wb_cyc_hp wb_cyc_ham wb_lag wb_mean5 wb_init5 {
  2.     local ++i
  3.     estimates restore D4_`v'
  4.     local lab : word `i' of "Annual: contemporaneous ratio" "Annual: % of 
> trend GDP (HP)" "Annual: % of trend GDP (Hamilton)" "Annual: lagged one year"
>  "5-year: period mean" "5-year: first year of period"
  5.     local df = e(df_r)
  6.     post `F' ("`v'") ("`lab'") (_b[`v']) (_se[`v']) (_b[`v'] - invttail(`d
> f', 0.025) * _se[`v']) ///
>         (_b[`v'] + invttail(`df', 0.025) * _se[`v']) (e(N)) (e(nc))
  7. }
(results D4_wb_contemp are active now)
(results D4_wb_cyc_hp are active now)
(results D4_wb_cyc_ham are active now)
(results D4_wb_lag are active now)
(results D4_wb_mean5 are active now)
(results D4_wb_init5 are active now)

. postclose `F'

. 
. * ---------------------------------------------------------------- Tabela A7 
> (D4)
. capture program drop postd4

. program define postd4, eclass
  1.     args b V df N nc
  2.     ereturn post `b' `V', dof(`df')
  3.     ereturn scalar N = `N'
  4.     ereturn scalar nc = `nc'
  5.     ereturn local cmd "d4table"
  6. end

. local stars "* p<0.10, ** p<0.05, *** p<0.01."

. foreach v in wb_contemp wb_cyc_hp wb_cyc_ham wb_lag wb_mean5 wb_init5 {
  2.     estimates restore D4_`v'
  3.     * renomeia o coeficiente para uma linha comum
.     matrix b = e(b)
  4.     matrix V = e(V)
  5.     local cn : colnames b
  6.     local cn : subinstr local cn "`v'" "wagebill_gdp", word
  7.     matrix colnames b = `cn'
  8.     matrix rownames V = `cn'
  9.     matrix colnames V = `cn'
 10.     local N = e(N)
 11.     local nc = e(nc)
 12.     local df = e(df_r)
 13.     postd4 b V `df' `N' `nc'
 14.     estimates store T_`v'
 15. }
(results D4_wb_contemp are active now)
(results D4_wb_cyc_hp are active now)
(results D4_wb_cyc_ham are active now)
(results D4_wb_lag are active now)
(results D4_wb_mean5 are active now)
(results D4_wb_init5 are active now)

