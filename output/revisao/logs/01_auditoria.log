. 
. * =====================================================================================
. * C. Paineis de medias nao sobrepostas (5 e 3 anos), com variantes de timing
. * =====================================================================================
. * t_p = primeiro ano do periodo; t_p - 1 = ultimo ano do periodo anterior
. capture program drop rv_painel

. program define rv_painel
  1.     args L
  2.     use "$RINT/anual_rv.dta", clear
  3.     keep if year >= 1978
  4.     gen period = floor((year - 1979) / `L')
  5.     gen year0 = 1979 + `L' * period
  6.     gen byte first = year == year0
  7.     gen byte notfirst = year > year0
  8.     * crescimento: media do periodo (draft 7) e media excluindo o primeiro ano (T2)
.     gen g_x1 = g if notfirst
  9.     gen g_excr = g if !inlist(year, 2008, 2009, 2020, 2021)
 10.     * valores no ano t_p - 1 (ultimo ano do periodo anterior) e em t_p
.     sort id year
 11.     local pre wb wb_ham wb_hp1 wb_hp2 wb_placebo wagebill_cg_wdi wagebill_comb cov_central wagebill_share exp_gdp ///
>         rev_gdp balance_gdp sh_goods sh_int sh_transf sh_inv sh_other inv open infl popg ctot_g hc lny merit wgi_ge ///
>         debt oldage_dep health_edu_share icrg_qog exec_left maj frac union_density clientelism_prog impartial ///
>         dem demage dem_new v2x_polyarchy govcons_gdp lwb_trend lgap_ham health_edu_cofog xconst
 12.     foreach v of local pre {
 13.         gen `v'_m1 = L.`v'
 14.         gen `v'_tp = `v'
 15.     }
 16.     * valores no ano t_p (draft 7) e em t_p - 1 so nas linhas do primeiro ano
.     foreach v of local pre {
 17.         replace `v'_m1 = . if !first
 18.         replace `v'_tp = . if !first
 19.     }
 20.     * WWBI (4.4): mesmo ano para folha e emprego publico, o mais proximo de t_p - 1, com prioridade para anos anteriores
.     * ordem de busca: t_p-1, t_p-2, t_p-3, t_p-4, t_p, t_p+1, t_p+2, t_p+3
.     gen int yd = .
 21.     gen pe_sel = .
 22.     gen wb_sel = .
 23.     gen prem_sel = .
 24.     gen premf_sel = .
 25.     gen ilo_sel = .
 26.     gen relh_sel = .
 27.     foreach d in 1 2 3 4 0 -1 -2 -3 {
 28.         local s = cond(`d' > 0, "L`d'.", cond(`d' < 0, "F`=-`d''.", ""))
 29.         replace pe_sel = `s'pubemp_share if first & missing(yd) & !missing(`s'pubemp_share, `s'wagebill_gdp)
 30.         replace wb_sel = `s'wagebill_gdp if first & missing(yd) & !missing(`s'pubemp_share, `s'wagebill_gdp)
 31.         replace relh_sel = `s'relwage_ham if first & missing(yd) & !missing(`s'pubemp_share, `s'wagebill_gdp)
 32.         replace ilo_sel = `s'ilo_pubemp_share if first & missing(yd) & !missing(`s'pubemp_share, `s'wagebill_gdp)
 33.         replace yd = `d' if first & missing(yd) & !missing(`s'pubemp_share, `s'wagebill_gdp)
 34.     }
 35.     * premio (mesma regra, so o premio)
.     gen int ydp = .
 36.     foreach d in 1 2 3 4 0 -1 -2 -3 {
 37.         local s = cond(`d' > 0, "L`d'.", cond(`d' < 0, "F`=-`d''.", ""))
 38.         replace prem_sel = `s'wwbi_prem_all if first & missing(ydp) & !missing(`s'wwbi_prem_all)
 39.         replace premf_sel = `s'wwbi_prem_formal if first & missing(ydp) & !missing(`s'wwbi_prem_all)
 40.         replace ydp = `d' if first & missing(ydp) & !missing(`s'wwbi_prem_all)
 41.     }
 42.     * crise no periodo e zona do euro 2008-2013
.     gen byte euro_0813 = euro & inrange(year, 2008, 2013)
 43.     gen ng = !missing(g)
 44.     gen ng_x1 = !missing(g_x1)
 45.     drop if year < 1979
 46.     collapse (mean) g g_x1 g_excr g_raw infl infl_raw inv open popg ctot_g ipriv tfp_g privemp_g debt ///
>         exp_gdp rev_gdp balance_gdp wb_mean = wb hc ///
>         (max) crisis_p = crisis_bank euro_0813_p = euro_0813 war_any = war ///
>         (firstnm) *_m1 *_tp yd ydp pe_sel wb_sel prem_sel premf_sel ilo_sel relh_sel ///
>         iso3 country region region_id income_grp oecd resource_rich federal micro year0 euro_year ///
>         (sum) ng ng_x1, by(id period)
 47.     replace g = . if ng < cond(`L' == 5, 3, 2)
 48.     replace g_x1 = . if ng_x1 < cond(`L' == 5, 3, 2)
 49.     rename lny_m1 lny0
 50.     xtset id period
 51.     gen L_g = L.g
 52.     * leads: folha no inicio do periodo seguinte
.     gen wb_tp_lead = F.wb_tp
 53.     gen wb_m1_lead = F.wb_m1
 54.     label var g "GDP per capita growth (%, period mean)"
 55.     label var g_x1 "GDP per capita growth (%, period mean excluding the first year)"
 56.     label var wb_tp "Wage bill, general government (% of GDP), t_p"
 57.     label var wb_m1 "Wage bill, general government (% of GDP), t_p - 1"
 58.     label var wb_ham_m1 "Wage bill (% of trend GDP, Hamilton), t_p - 1"
 59.     label var wb_mean "Wage bill (% of GDP), period mean"
 60.     gen byte early2 = 0
 61.     bysort id (period): replace early2 = _n <= 2 if !missing(wb_m1)
 62.     compress
 63.     save "$RINT/p`L'_rv.dta", replace
 64. end

. rv_painel 5
