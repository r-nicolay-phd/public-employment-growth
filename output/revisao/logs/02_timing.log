Panel variable: id (strongly balanced)
 Time variable: period, 0 to 14
         Delta: 1 unit

. foreach t in T3 T6 {
  2.     local spec = cond("`t'" == "T3", "g wb_m1 $XP", "g wb_tp $XD")
  3.     gettoken dep rest : spec
  4.     gettoken w ctrl : rest
  5.     reghdfe `dep' `w' `ctrl' i.period, absorb(id) vce(cluster id)
  6.     local b = _b[`w']
  7.     local se = _se[`w']
  8.     local p = 2 * ttail(e(df_r), abs(`b' / `se'))
  9.     estimates store `t'_3y
 10.     rv_boot `w'
 11.     post `P' ("`t'") ("3y") (`b') (`se') (`p') (r(p)) (r(lo)) (r(hi)) (e(N)) (e(N_clust))
 12.     rv_kv `t'_3y_b `=string(`b', "%9.4f")'
 13.     rv_kv `t'_3y_p `=string(`p', "%9.4f")'
 14.     rv_kv `t'_3y_N `e(N)'
 15. }
