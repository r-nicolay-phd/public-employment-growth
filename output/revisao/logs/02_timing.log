. xtset id period

Panel variable: id (strongly balanced)
 Time variable: period, 0 to 8
         Delta: 1 unit

. 
. tempname P

. postfile `P' str8 spec str8 smp double(b se p pboot lo hi) long(N nc) using "$RINT/timing.dta", replace

. * spec: dependente, folha, controles
. local s_T1 "g wb_m1 $XD"

. local s_T2 "g_x1 wb_tp $XD"

. local s_T3 "g wb_m1 $XP"

. local s_T4 "g wb_m1 $XPN"

. local s_T5 "g wb_ham_m1 $XP"

. local s_T6 "g wb_tp $XD"

. foreach t in T1 T2 T3 T4 T5 T6 {
  2.     gettoken dep rest : s_`t'
  3.     gettoken w ctrl : rest
  4.     foreach smp in own base {
  5.         local cond = cond("`smp'" == "own", "1", "S5_base == 1")
  6.         reghdfe `dep' `w' `ctrl' i.period if `cond', absorb(id) vce(cluster id)
  7.         local b = _b[`w']
  8.         local se = _se[`w']
  9.         local p = 2 * ttail(e(df_r), abs(`b' / `se'))
 10.         local N = e(N)
 11.         local nc = e(N_clust)
 12.         estimates store `t'_`smp'
 13.         rv_boot `w'
 14.         local pb = r(p)
 15.         local lo = r(lo)
 16.         local hi = r(hi)
 17.         post `P' ("`t'") ("`smp'") (`b') (`se') (`p') (`pb') (`lo') (`hi') (`N') (`nc')
 18.         rv_kv `t'_`smp'_b `=string(`b', "%9.4f")'
 19.         rv_kv `t'_`smp'_se `=string(`se', "%9.4f")'
 20.         rv_kv `t'_`smp'_p `=string(`p', "%9.4f")'
 21.         rv_kv `t'_`smp'_pboot `=string(`pb', "%9.4f")'
 22.         rv_kv `t'_`smp'_lo `=string(`lo', "%9.4f")'
 23.         rv_kv `t'_`smp'_hi `=string(`hi', "%9.4f")'
 24.         rv_kv `t'_`smp'_N `N'
 25.         rv_kv `t'_`smp'_nc `nc'
 26.     }
 27. }
