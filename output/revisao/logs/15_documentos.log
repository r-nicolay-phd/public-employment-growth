. file write `O' "# Stata packages used in the revision" _n _n

. file write `O' "Stata 17 (StataMP). Community-contributed packages installed in \`ado/plus\` by \`code/revisao/00_instala.do\`; list read from \`ado/plus/stata.trk\` by \`code/revisao/15_documentos.
> do\`. Packages that could not be installed from the author's source were copied from the draft-7 package folder (\`code/ado/plus\`): xthenreg, xthreg, bma and wals." _n _n

. file write `O' "| Package | Source | Distribution date | Installed |" _n "|---|---|---|---|" _n

. local pkg ""

. local src ""

. local dd ""

. local inst ""

. file read `T' line

. while r(eof) == 0 {
  2.     local c = substr(`"`macval(line)'"', 1, 2)
  3.     if "`c'" == "S " local src = substr(`"`macval(line)'"', 3, .)
  4.     if "`c'" == "N " local pkg = subinstr(substr(`"`macval(line)'"', 3, .), ".pkg", "", .)
  5.     if "`c'" == "D " local inst = substr(`"`macval(line)'"', 3, .)
  6.     if strpos(`"`macval(line)'"', "Distribution-Date") local dd = strtrim(substr(`"`macval(line)'"', strpos(`"`macval(line)'"', ":") + 1, .))
  7.     if "`c'" == "e" | `"`macval(line)'"' == "e" {
  8.         if "`pkg'" != "" file write `O' "| `pkg' | `src' | `dd' | `inst' |" _n
  9.         local pkg ""
 10.         local dd ""
 11.         local inst ""
 12.     }
 13.     file read `T' line
 14. }

