. foreach out in y100 ipriv {
  2.     forvalues hh = 0/6 {
  3.         tempvar dy
  4.         quietly gen double `dy' = F`hh'.`out' - L.`out'
  5.         quietly xtscc `dy' afg_sal afg_nonsal afg_tax L(1/2).g i.year if pAFG, fe lag($DKLAG)
  6.         local b = _b[afg_sal]
  7.         local se = _se[afg_sal]
  8.         local df = e(df_r)
  9.         local N = e(N)
 10.         local nc = e(N_g)
 11.         local pb = .
 12.         if `hh' == 4 {
 13.             * exploratorio: wild cluster bootstrap por pais (16 clusters) no mesmo modelo com EF de pais
.             quietly reghdfe `dy' afg_sal afg_nonsal afg_tax L(1/2).g i.year if pAFG, absorb(id) vce(cluster id)
 14.             capture rv_boot afg_sal
 15.             if !_rc local pb = r(p)
 16.         }
 17.         post `Q' ("`out'") (`hh') (`b') (`se') (`b' - invttail(`df', 0.025) * `se') (`b' + invttail(`df', 0.025) * `se') ///
>             (2 * ttail(`df', abs(`b' / `se'))) (`pb') (`N') (`nc')
 18.         if `hh' == 4 {
 19.             rv_kv afg_`out'_h4_b `=string(`b', "%9.4f")'
 20.             rv_kv afg_`out'_h4_p `=string(2 * ttail(`df', abs(`b' / `se')), "%9.4f")'
 21.             rv_kv afg_`out'_h4_pboot `=string(`pb', "%9.4f")'
 22.             rv_kv afg_`out'_h4_N `N'
 23.         }
 24.         drop `dy'
 25.     }
 26. }

. postclose `Q'

