. rv_new, ncol(7) head1("h = 0" "h = 1" "h = 2" "h = 3" "h = 4" "h = 5" "h = 6")

. foreach out in y100 ipriv {
  2.     local cb ""
  3.     local cs ""
  4.     forvalues hh = 0/6 {
  5.         quietly summ b if out == "`out'" & h == `hh'
  6.         local b = r(mean)
  7.         quietly summ p if out == "`out'" & h == `hh'
  8.         rv_fmt `b' %12.3f `=r(mean)'
  9.         local cb `"`cb' "`r(s)'""'
 10.         quietly summ se if out == "`out'" & h == `hh'
 11.         rv_fmt `=r(mean)' %12.3f
 12.         local cs `"`cs' "(`r(s)')""'
 13.     }
 14.     local lab = cond("`out'" == "y100", "GDP per capita (100 × log)", "Private investment (% of GDP)")
 15.     rv_row "`lab'" `cb'
 16.     rv_row "" `cs'
 17.     quietly summ pboot if out == "`out'" & h == 4
 18.     rv_row "Wild cluster bootstrap p (h = 4, exploratory)" "" "" "" "" "`=string(r(mean), "%5.3f")'" "" ""
 19.     quietly summ N if out == "`out'" & h == 0
 20.     local n0 = r(mean)
 21.     quietly summ N if out == "`out'" & h == 6
 22.     rv_row "Observations (h = 0 / h = 6)" "`=string(`n0', "%9.0fc")'" "" "" "" "" "" "`=string(r(mean), "%9.0fc")'"
 23.     rv_mid
 24. }

