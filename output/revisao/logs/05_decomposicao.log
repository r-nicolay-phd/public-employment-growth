. tempname P

. postfile `P' str10 spec str10 v double(b se p pboot sdw) long(N nc) using "$RINT/decomp.dta", replace

. capture program drop postd

. program define postd
  1.     * postd P spec var: coeficiente, p (cluster), p (wild bootstrap) e DP dentro do pais na amostra
.     args P spec v
  2.     local b = _b[`v']
  3.     local se = _se[`v']
  4.     local p = 2 * ttail(e(df_r), abs(`b' / `se'))
  5.     tempvar dm
  6.     quietly bysort id: egen double `dm' = mean(`v') if e(sample)
  7.     quietly summ `v' if e(sample)
  8.     tempvar w
  9.     quietly gen double `w' = `v' - `dm' if e(sample)
 10.     quietly summ `w'
 11.     local sdw = r(sd)
 12.     local N = e(N)
 13.     local nc = e(N_clust)
 14.     capture rv_boot `v'
 15.     local pb = cond(_rc, ., r(p))
 16.     post `P' ("`spec'") ("`v'") (`b') (`se') (`p') (`pb') (`sdw') (`N') (`nc')
 17.     rv_kv d_`spec'_`v'_b `=string(`b', "%9.4f")'
 18.     rv_kv d_`spec'_`v'_se `=string(`se', "%9.4f")'
 19.     rv_kv d_`spec'_`v'_p `=string(`p', "%9.4f")'
 20.     rv_kv d_`spec'_`v'_pboot `=string(`pb', "%9.4f")'
 21.     rv_kv d_`spec'_`v'_sdw `=string(`sdw', "%9.4f")'
 22.     rv_kv d_`spec'_N `N'
 23. end

