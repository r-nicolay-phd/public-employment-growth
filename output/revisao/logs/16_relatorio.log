. mata:
------------------------------------------------- mata (type end to exit) ------------------------------------------------------------------------------------------------------------------------------
: string scalar _pt(real scalar x, real scalar d)
> {
>     string scalar s
>     if (x >= .) return("n.d.")
>     if (d == 0) {
>         s = strofreal(abs(round(x)), "%15.0fc")
>         s = subinstr(s, ",", ".")
>     }
>     else {
>         s = strofreal(abs(x), "%15." + strofreal(d) + "f")
>         s = subinstr(strtrim(s), ".", ",")
>     }
>     s = strtrim(s)
>     if (x < 0 & s != "0" & s != "0,000" & s != "0,00") s = uchar(8722) + s
>     return(s)
> }

: string scalar _pp(real scalar p)
> {
>     if (p >= .) return("n.d.")
>     if (p < 0.001) return("< 0,001")
>     return(subinstr(strofreal(p, "%5.3f"), ".", ","))
> }

: end
