. * contagem de palavras do resumo (limite de 200)
. tempname I

. file open `I' using "$DOCS/TEXTO_SUGERIDO.md", read text

. local inabs = 0

. local nw = 0

. file read `I' line

. while r(eof) == 0 {
  2.     if strpos(`"`macval(line)'"', "## Resumo") local inabs = 1
  3.     else if strpos(`"`macval(line)'"', "## Parágrafo") local inabs = 0
  4.     else if `inabs' local nw = `nw' + wordcount(`"`macval(line)'"')
  5.     file read `I' line
  6. }

. file close `I'

. di "Palavras no resumo sugerido: `nw'"
