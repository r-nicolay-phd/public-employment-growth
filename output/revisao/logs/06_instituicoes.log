. * =====================================================================================
. * B. Replica aproximada de Mollick e Vianna (2023): painel anual 1996-2019, consumo x media do WGI
. * =====================================================================================
. use "$RINT/anual_rv.dta", clear

. keep if micro == 0 & inrange(year, 1993, 2023)
(5,430 observations deleted)

. xtset id year

Panel variable: id (strongly balanced)
 Time variable: year, 1993 to 2023
         Delta: 1 unit

. egen inst = rowmean(wgi_ge wgi_rq wgi_rl wgi_cc wgi_va wgi_pv)
(1,020 missing values generated)

. gen gc = govcons_gdp
(622 missing values generated)

. gen gc_l1 = L.govcons_gdp
(773 missing values generated)

. gen gc_ham = govcons_gdp * exp(lnY - lnY_ham)
(644 missing values generated)

. gen g_l1 = L.g
(291 missing values generated)

. gen lny_l1 = L.lny
(284 missing values generated)

. keep if inrange(year, 1996, 2023)
(504 observations deleted)

. gen byte sMV = !missing(g, gc, gc_l1, gc_ham, inst, g_l1, lny_l1, hc, inv, open, infl, popg, ctot_g) & year <= 2019

. quietly summ inst if sMV

. gen instc = inst - r(mean)
(516 missing values generated)

. foreach meas in gc gc_ham gc_l1 {
  2.     capture drop G
  3.     capture drop GXI
  4.     gen G = `meas'
  5.     gen GXI = G * instc
  6.     xtscc g G instc GXI g_l1 lny_l1 hc inv open infl popg ctot_g i.year if sMV, fe lag($DKLAG)
  7.     post `P' ("mv") ("`meas'") ("fe_dk") (_b[GXI]) (_se[GXI]) (2 * ttail(e(df_r), abs(_b[GXI] / _se[GXI]))) ///
>         (_b[G]) (_se[G]) (e(N)) (e(N_g)) (.)
  8.     estimates store R_mv_`meas'
  9.     rv_kv mv_`meas'_bi `=string(_b[GXI], "%9.4f")'
 10.     rv_kv mv_`meas'_pi `=string(2 * ttail(e(df_r), abs(_b[GXI] / _se[GXI])), "%9.4f")'
 11. }
(528 missing values generated)
