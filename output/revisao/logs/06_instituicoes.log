. foreach i in ge cc rl {
  2.     capture drop I
  3.     gen I = wgi_`i'
  4.     gen byte sC_`i' = !missing(gy, gy_l1, I, lgy, lgy_l1, lgy_ham, liy, popg)
  5.     foreach per in full pre post {
  6.         if "`i'" != "ge" & "`per'" != "full" continue
  7.         local cp = cond("`per'" == "full", "1", cond("`per'" == "pre", "year <= 2007", "year >= 2008"))
  8.         foreach k in "own lgy" "common lgy" "common lgy_ham" "common lgy_l1" {
  9.             tokenize `k'
 10.             local smp `1'
 11.             local meas `2'
 12.             capture drop G
 13.             capture drop GX
 14.             gen G = `meas'
 15.             gen GX = G * I
 16.             local sm = cond("`smp'" == "own", "1", "sC_`i'")
 17.             * efeitos de ano como regressores: o R2 within inclui os efeitos de ano, como no xtreg, fe do artigo
.             quietly reghdfe gy gy_l1 I G GX liy popg i.year if `sm' & `cp', absorb(id) vce(cluster id)
 18.             local pcl = 2 * ttail(e(df_r), abs(_b[GX] / _se[GX]))
 19.             reghdfe gy gy_l1 I G GX liy popg i.year if `sm' & `cp', absorb(id) vce(robust)
 20.             capture drop tgN
 21.             egen tgN = tag(id) if e(sample)
 22.             quietly count if tgN == 1
 23.             local nc = r(N)
 24.             post `M' ("`i'") ("`per'") ("`smp'") ("`meas'") (_b[G]) (_se[G]) (_b[I]) (_se[I]) (_b[GX]) (_se[GX]) ///
>                 (2 * ttail(e(df_r), abs(_b[GX] / _se[GX]))) (`pcl') (e(r2_within)) (e(N)) (`nc')
