. rv_new, ncol(6) head1("Period mean (contemporaneous)" "" "First year (t_p)" "" "t_p − 1" "") ///
>     head2("System GMM" "Fixed effects" "System GMM" "Fixed effects" "System GMM" "Fixed effects")

. foreach rep in opra_icrg opra_wgi {
  2.     local ttl = cond("`rep'" == "opra_icrg", "A. Oto-Peralías and Romero-Ávila (2013): five-year averages 1981–2005, ICRG quality of government (QoG)", ///
>         "B. Same specification, WGI government effectiveness, five-year averages 1996–2020")
  3.     rv_row "`ttl'" "" "" "" "" "" ""
  4.     foreach row in i g {
  5.         local cb ""
  6.         local cs ""
  7.         foreach meas in gc_mean gc_tp gc_m1 {
  8.             foreach est in sgmm fe {
  9.                 quietly summ b`row' if rep == "`rep'" & meas == "`meas'" & est == "`est'"
 10.                 if r(N) == 0 {
