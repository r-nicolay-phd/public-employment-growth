. tempname P

. postfile `P' str14 rep str10 meas str8 est double(bi sei pi bg seg) long(N nc nins) using "$RINT/replicas.dta", replace

. 
. * =====================================================================================
. * A. Replica de Oto-Peralias e Romero-Avila (2013): paineis de cinco anos 1981-1985 a 2001-2005
. * =====================================================================================
. * A1. painel alinhado a 1981 (como no artigo), com o consumo do governo na media do periodo, em t_p e em t_p - 1
. capture program drop opra_painel

. program define opra_painel
  1.     args y0 y1
  2.     use "$RINT/anual_rv.dta", clear
  3.     keep if micro == 0 & inrange(year, `=`y0' - 1', `y1')
  4.     xtset id year
  5.     gen period = floor((year - `y0') / 5)
  6.     gen year0 = `y0' + 5 * period
  7.     gen byte first = year == year0
  8.     egen wgi6 = rowmean(wgi_ge wgi_rq wgi_rl wgi_cc wgi_va wgi_pv)
  9.     foreach v in govcons_gdp lny {
 10.         gen `v'_tp = `v' if first
 11.         gen `v'_m1 = L.`v' if first
 12.     }
 13.     drop if year < `y0'
 14.     collapse (mean) g gc_mean = govcons_gdp icrg = icrg_qog wgi6 wgi_ge xconst secenr inv dependency ///
>         (firstnm) gc_tp = govcons_gdp_tp gc_m1 = govcons_gdp_m1 lny0 = lny_m1 iso3 oecd, by(id period)
 15.     xtset id period
 16. end

. 
. capture program drop opra_est

. program define opra_est
  1.     * opra_est P rotulo instituicao medida
.     args P rep inst meas
  2.     capture drop G
  3.     capture drop GXI
  4.     gen G = `meas'
  5.     gen GXI = G * `inst'
  6.     quietly tab period, gen(pd)
  7.     capture drop pd1
  8.     * System GMM (dois passos, colapsado): consumo, interacao e investimento endogenos; renda inicial e matricula
.     * predeterminadas; dummies de periodo exogenas; razao de dependencia como instrumento excluido
.     capture noisily xtabond2 g G GXI `inst' lny0 secenr inv pd*, gmm(G GXI inv, lag(2 .) collapse) ///
>         gmm(lny0 secenr `inst', lag(1 .) collapse) iv(pd* dependency) twostep robust small
  9.     if !_rc {
 10.         post `P' ("`rep'") ("`meas'") ("sgmm") (_b[GXI]) (_se[GXI]) (2 * ttail(e(df_r), abs(_b[GXI] / _se[GXI]))) ///
>             (_b[G]) (_se[G]) (e(N)) (e(N_g)) (e(j))
 11.         estimates store R_`rep'_`meas'_sgmm
 12.     }
 13.     * efeitos fixos de pais e periodo
.     reghdfe g G GXI `inst' lny0 secenr inv i.period, absorb(id) vce(cluster id)
 14.     post `P' ("`rep'") ("`meas'") ("fe") (_b[GXI]) (_se[GXI]) (2 * ttail(e(df_r), abs(_b[GXI] / _se[GXI]))) ///
>         (_b[G]) (_se[G]) (e(N)) (e(N_clust)) (.)
 15.     estimates store R_`rep'_`meas'_fe
 16.     drop pd*
 17. end

. 
