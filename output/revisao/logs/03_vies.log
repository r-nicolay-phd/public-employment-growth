. * =====================================================================================
. * 4.2.7 e 4.2.8 projecoes locais: nivel predeterminado (sobre Hamilton) e choque com leads (h = -3 ... 6)
. * =====================================================================================
. use "$RINT/anual_rv.dta", clear

. keep if micro == 0 & inrange(year, 1985, 2023)
(4,086 observations deleted)

. xtset id year

Panel variable: id (strongly balanced)
 Time variable: year, 1985 to 2023
         Delta: 1 unit

. tempname Q

. postfile `Q' str10 shock int h double(b se lo hi) long(N nc) using "$RINT/vies_lp.dta", replace
(file C:\Users\Usuario\Dropbox\Papers\Emprego Público e Crescimento\Estimações/data/interim/revisao/vies_lp.dta not found)

. forvalues hh = -3/6 {
  2.     if `hh' < 0 local lhs "L`=-`hh''.y100 - L.y100"
  3.     else local lhs "F`hh'.y100 - L.y100"
  4.     if `hh' == -1 continue
  5.     tempvar dy
  6.     gen double `dy' = `lhs'
  7.     * choque real da folha (WageShock) com duas defasagens do choque e do crescimento
.     quietly xtscc `dy' d_wagebill_real L(1/2).d_wagebill_real L(1/2).g i.year if inrange(year, 1996, 2023), fe lag($DKLAG)
  8.     local df = e(df_r)
  9.     post `Q' ("shock") (`hh') (_b[d_wagebill_real]) (_se[d_wagebill_real]) (_b[d_wagebill_real] - invttail(`df', 0.025) * _se[d_wagebill_real]) ///
>         (_b[d_wagebill_real] + invttail(`df', 0.025) * _se[d_wagebill_real]) (e(N)) (e(N_g))
 10.     * nivel da folha em t - 1 sobre o PIB tendencial (Hamilton)
.     if `hh' >= 0 {
 11.         quietly xtscc `dy' L.wb_ham L(1/2).g i.year if inrange(year, 1996, 2023), fe lag($DKLAG)
 12.         local df = e(df_r)
 13.         post `Q' ("level") (`hh') (_b[L.wb_ham]) (_se[L.wb_ham]) (_b[L.wb_ham] - invttail(`df', 0.025) * _se[L.wb_ham]) ///
>             (_b[L.wb_ham] + invttail(`df', 0.025) * _se[L.wb_ham]) (e(N)) (e(N_g))
 14.     }
 15.     drop `dy'
 16. }
