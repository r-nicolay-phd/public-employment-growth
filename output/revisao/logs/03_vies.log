. preserve

. use "$RINT/p5_rv.dta", clear

. keep if micro == 0
(261 observations deleted)

. xtset id period

Panel variable: id (strongly balanced)
 Time variable: period, 0 to 8
         Delta: 1 unit

. gen byte s5 = !missing(g, wb_mean, wb_tp, wb_m1, wb_ham_m1, lny0, hc_tp, inv, open, infl, popg, ctot_g)

. foreach v in wb_mean wb_tp wb_m1 wb_ham_m1 {
  2.     reghdfe g `v' lny0 hc_tp inv open infl popg ctot_g i.period if s5, absorb(id) vce(cluster id)
  3.     estimates store M5_`v'
  4.     local b = _b[`v']
  5.     local se = _se[`v']
  6.     local df = e(df_r)
  7.     local lab = cond("`v'" == "wb_mean", "5-year: period mean", cond("`v'" == "wb_tp", "5-year: t_p", ///
>         cond("`v'" == "wb_m1", "5-year: t_p − 1", "5-year: t_p − 1, % of trend GDP (Hamilton)")))
  8.     post `P' ("`v'") ("`lab'") (`b') (`se') (2 * ttail(`df', abs(`b' / `se'))) (`b' - invttail(`df', 0.025) * `se') ///
>         (`b' + invttail(`df', 0.025) * `se') (e(N)) (e(N_clust))
  9.     rv_kv vies5_`v'_b `=string(`b', "%9.4f")'
 10.     rv_kv vies5_`v'_p `=string(2 * ttail(`df', abs(`b' / `se')), "%9.4f")'
 11. }
