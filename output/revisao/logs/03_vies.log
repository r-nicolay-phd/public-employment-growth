. tempname P

. postfile `P' str16 m str60 lab double(b se p lo hi) long(N nc) using "$RINT/vies_medidas.dta", replace
(file C:\Users\Usuario\Dropbox\Papers\Emprego Público e Crescimento\Estimações/data/interim/revisao/vies_medidas.dta not found)

. capture program drop postx

. program define postx
  1.     args P m lab v
  2.     local b = _b[`v']
  3.     local se = _se[`v']
  4.     local df = e(df_r)
  5.     post `P' ("`m'") ("`lab'") (`b') (`se') (2 * ttail(`df', abs(`b' / `se'))) (`b' - invttail(`df', 0.025) * `se') ///
>         (`b' + invttail(`df', 0.025) * `se') (e(N)) (e(N_g))
  6.     rv_kv vies_`m'_b `=string(`b', "%9.4f")'
  7.     rv_kv vies_`m'_se `=string(`se', "%9.4f")'
  8.     rv_kv vies_`m'_p `=string(2 * ttail(`df', abs(`b' / `se')), "%9.4f")'
  9.     rv_kv vies_`m'_N `e(N)'
 10. end

. * 4.2.3 medidas (mesmo modelo, mesma amostra)
. foreach v in wb wb_hp2 wb_hp1 wb_ham wb_l1 wbham_l1 wb_placebo {
  2.     xtscc g `v' $XA i.year if sA, fe lag($DKLAG)
  3.     estimates store M_`v'
  4.     local lab = cond("`v'" == "wb", "Contemporaneous ratio", cond("`v'" == "wb_hp2", "% of trend GDP, two-sided HP", ///
>         cond("`v'" == "wb_hp1", "% of trend GDP, one-sided HP", cond("`v'" == "wb_ham", "% of trend GDP, Hamilton", ///
>         cond("`v'" == "wb_l1", "Lagged one year", cond("`v'" == "wbham_l1", "Lagged one year, % of trend GDP (Hamilton)", ///
>         "Placebo numerator (denominator only)"))))))
  5.     postx `P' `v' "`lab'" `v'
  6. }

