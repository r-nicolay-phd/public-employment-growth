. * checagem: os coeficientes empilhados reproduzem as regressoes separadas
. di "empilhado: contemp = " _b[x1] ", Hamilton = " _b[x2] ", defasada = " _b[x3] ", HP unilateral = " _b[x4]
empilhado: contemp = -.72253984, Hamilton = -.01559313, defasada = -.00076457, HP unilateral = -.42283527

. tempname D

. postfile `D' str40 dif double(d lo hi p) using "$RINT/vies_diferencas.dta", replace
(file C:\Users\Usuario\Dropbox\Papers\Emprego Público e Crescimento\Estimações/data/interim/revisao/vies_diferencas.dta not found)

. foreach pair in "1 2" "1 3" "1 4" "3 2" "1 5" "3 6" {
  2.     gettoken a c : pair
  3.     local c = strtrim("`c'")
  4.     lincom x`a' - x`c'
  5.     local d = r(estimate)
  6.     boottest {x`a' - x`c' = 0}, reps(9999) weighttype(webb) seed(20261017) nograph
  7.     local pb = r(p)
  8.     matrix CI = r(CI)
  9.     local nm = cond("`pair'" == "1 2", "Contemporaneous − Hamilton", cond("`pair'" == "1 3", "Contemporaneous − lagged", ///
>         cond("`pair'" == "1 4", "Contemporaneous − one-sided HP", cond("`pair'" == "3 2", "Lagged − Hamilton", ///
>         cond("`pair'" == "1 5", "Contemporaneous − two-sided HP", "Lagged − lagged over Hamilton trend")))))
 10.     post `D' ("`nm'") (`d') (CI[1, 1]) (CI[1, 2]) (`pb')
 11.     rv_kv dif_`a'`c'_d `=string(`d', "%9.4f")'
 12.     rv_kv dif_`a'`c'_p `=string(`pb', "%9.4f")'
 13.     rv_kv dif_`a'`c'_lo `=string(CI[1, 1], "%9.4f")'
 14.     rv_kv dif_`a'`c'_hi `=string(CI[1, 2], "%9.4f")'
 15. }

