. global XP "lny0 hc_m1 inv_m1 open_m1 infl_m1 popg_m1 ctot_g_m1"

. tempname E

. postfile `E' str20 m double(b se p pboot) long(N nc) using "$RINT/vies_leads.dta", replace
(file C:\Users\Usuario\Dropbox\Papers\Emprego Público e Crescimento\Estimações/data/interim/revisao/vies_leads.dta not found)

. foreach v in wb_tp_lead wb_m1_lead {
  2.     reghdfe g `v' $XP i.period, absorb(id) vce(cluster id)
  3.     estimates store LEAD_`v'
  4.     local b = _b[`v']
  5.     local se = _se[`v']
  6.     local p = 2 * ttail(e(df_r), abs(`b' / `se'))
  7.     rv_boot `v'
  8.     post `E' ("`v'") (`b') (`se') (`p') (r(p)) (e(N)) (e(N_clust))
  9.     rv_kv lead_`v'_b `=string(`b', "%9.4f")'
 10.     rv_kv lead_`v'_p `=string(`p', "%9.4f")'
 11.     rv_kv lead_`v'_pboot `=string(r(p), "%9.4f")'
 12. }
