. * =====================================================================================
. * 4.2.6 defasagens distribuidas (1 a 5): em % do PIB e sobre o PIB tendencial (Hamilton)
. * =====================================================================================
. tempname L

. postfile `L' str8 ser str12 term double(b se p pboot lo hi) long(N nc) using "$RINT/vies_dl.dta", replace
(file C:\Users\Usuario\Dropbox\Papers\Emprego Público e Crescimento\Estimações/data/interim/revisao/vies_dl.dta not found)

. foreach ser in wbL whL {
  2.     gen byte sDL_`ser' = !missing(g, `ser'1, `ser'2, `ser'3, `ser'4, `ser'5, g_l1, lny_l1, hc, inv, open, infl, popg, ctot_g)
  3.     xtscc g `ser'1-`ser'5 $XA i.year if sDL_`ser', fe lag($DKLAG)
  4.     estimates store DL_`ser'
  5.     local N = e(N)
  6.     local nc = e(N_g)
  7.     local df = e(df_r)
  8.     forvalues k = 1/5 {
  9.         post `L' ("`ser'") ("lag`k'") (_b[`ser'`k']) (_se[`ser'`k']) (2 * ttail(`df', abs(_b[`ser'`k'] / _se[`ser'`k']))) (.) (.) (.) (`N') (`nc')
 10.     }
 11.     lincom `ser'1 + `ser'2 + `ser'3 + `ser'4 + `ser'5
 12.     local sb = r(estimate)
 13.     local ss = r(se)
 14.     local sp = r(p)
 15.     local slo = r(lb)
 16.     local shi = r(ub)
 17.     * mesmo modelo com efeitos fixos e erros agrupados por pais, para o wild bootstrap da soma
.     reghdfe g `ser'1-`ser'5 $XA i.year if sDL_`ser', absorb(id) vce(cluster id)
 18.     lincom `ser'1 + `ser'2 + `ser'3 + `ser'4 + `ser'5
 19.     local cb = r(estimate)
 20.     boottest {`ser'1 + `ser'2 + `ser'3 + `ser'4 + `ser'5 = 0}, reps(9999) weighttype(webb) seed(20261017) nograph
 21.     local pb = r(p)
 22.     matrix CI = r(CI)
 23.     post `L' ("`ser'") ("sum_dk") (`sb') (`ss') (`sp') (.) (`slo') (`shi') (`N') (`nc')
 24.     post `L' ("`ser'") ("sum_boot") (`cb') (.) (.) (`pb') (CI[1, 1]) (CI[1, 2]) (`N') (`nc')
 25.     rv_kv dl_`ser'_sum `=string(`sb', "%9.4f")'
 26.     rv_kv dl_`ser'_sum_se `=string(`ss', "%9.4f")'
 27.     rv_kv dl_`ser'_sum_p `=string(`sp', "%9.4f")'
 28.     rv_kv dl_`ser'_sum_lo `=string(`slo', "%9.4f")'
 29.     rv_kv dl_`ser'_sum_hi `=string(`shi', "%9.4f")'
 30.     rv_kv dl_`ser'_sum_pboot `=string(`pb', "%9.4f")'
 31.     rv_kv dl_`ser'_sum_bootlo `=string(CI[1, 1], "%9.4f")'
 32.     rv_kv dl_`ser'_sum_boothi `=string(CI[1, 2], "%9.4f")'
 33.     rv_kv dl_`ser'_N `N'
 34. }

