. 
. * =====================================================================================
. * B. Romano-Wolf (step-down) com as mesmas 999 reamostras de paises em todos os testes
. * =====================================================================================
. * rwolf2 nao aceita equacoes em bases distintas (cinco anos e anual) nem troca o identificador dos efeitos
. * fixos nas reamostras; a implementacao abaixo segue Romano e Wolf (2005, 2016): t* = (b* - b) / se* em cada
. * reamostra de paises (efeitos fixos no identificador da copia), p ajustado pelo maximo |t*| dos testes restantes.
. local B = 999

. use "$RINT/anual_rv.dta", clear

. keep if micro == 0
(1,566 observations deleted)

. keep id

. duplicates drop

Duplicates in terms of all variables

(8,904 observations deleted)

. tempfile ids

. save `ids'
file C:\Users\Usuario\AppData\Local\Temp\ST_3798_000001.tmp saved as .dta format

. set seed 20261017

. forvalues r = 1/`B' {
  2.     quietly use `ids', clear
  3.     quietly bsample
  4.     quietly contract id, freq(n`r')
  5.     if `r' == 1 {
  6.         tempfile W
  7.         quietly save `W'
  8.     }
  9.     else {
 10.         quietly merge 1:1 id using `W', nogen
 11.         quietly save `W', replace
 12.     }
 13. }

. use `W', clear

. forvalues r = 1/`B' {
  2.     quietly replace n`r' = 0 if missing(n`r')
  3. }

. save "$RINT/rw_draws.dta", replace
(file C:\Users\Usuario\Dropbox\Papers\Emprego Público e Crescimento\Estimações/data/interim/revisao/rw_draws.dta not found)
file C:\Users\Usuario\Dropbox\Papers\Emprego Público e Crescimento\Estimações/data/interim/revisao/rw_draws.dta saved

. 
. capture program drop rw_test

. program define rw_test
  1.     * rw_test codigo arquivo "condicao" "comando com @ no lugar do id dos efeitos fixos" var tvar(year|period)
.     args code file cond cmd v tv
  2.     local cmd0 : subinstr local cmd "@" "id", all
  3.     local cmdb : subinstr local cmd "@" "bid", all
  4.     quietly use "`file'", clear
  5.     quietly keep if `cond'
  6.     quietly `cmd0'
  7.     local b0 = _b[`v']
  8.     local t0 = _b[`v'] / _se[`v']
  9.     quietly keep if e(sample)
 10.     quietly merge m:1 id using "$RINT/rw_draws.dta", keep(match) nogen
 11.     tempfile base
 12.     quietly save `base'
 13.     tempname R
 14.     postfile `R' int r double tstar using "$RINT/rw_`code'.dta", replace
 15.     forvalues r = 1/$RWB {
 16.         quietly use `base', clear
 17.         quietly drop if n`r' == 0
 18.         quietly expand n`r'
 19.         quietly bysort id `tv': gen int cp = _n
 20.         quietly egen long bid = group(id cp)
 21.         capture quietly `cmdb'
 22.         if !_rc post `R' (`r') ((_b[`v'] - `b0') / _se[`v'])
 23.         else post `R' (`r') (.)
 24.     }
 25.     postclose `R'
 26.     post RWT ("`code'") (`b0') (`t0')
 27. end

. global RWB = `B'

