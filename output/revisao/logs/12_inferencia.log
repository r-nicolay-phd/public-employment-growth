. * p-valores ajustados (Romano-Wolf step-down)
. capture program drop rw_adjust

. program define rw_adjust
  1.     args fam
  2.     use "$RINT/rw_`fam'.dta", clear
  3.     local K = _N
  4.     forvalues k = 1/`K' {
  5.         local c`k' = code[`k']
  6.     }
  7.     tempname T
  8.     mkmat t, matrix(`T')
  9.     local B = $RWB
 10.     mata: TS = J(`B', `K', .)
 11.     forvalues k = 1/`K' {
 12.         preserve
 13.         use "$RINT/rw_`c`k''.dta", clear
 14.         mata: TS[., `k'] = st_data(., "tstar")
 15.         restore
 16.     }
 17.     * reamostras que falharam (raras) entram com t* = 0
.     mata: TS = editmissing(TS, 0)
 18.     mata: _rwp(st_matrix("`T'"), TS)
 19.     gen double p_raw = .
 20.     gen double p_rw = .
 21.     forvalues k = 1/`K' {
 22.         replace p_raw = PR[`k', 1] in `k'
 23.         replace p_rw = PRW[`k', 1] in `k'
 24.     }
 25.     list, noobs
 26.     save "$RINT/rw_`fam'_adj.dta", replace
 27. end

. mata:
------------------------------------------------- mata (type end to exit) ------------------------------------------------------------------------------------------------------------------------------
: void _rwp(real colvector t, real matrix TS)
> {
>     real scalar K, B, j, i, r, cnt, cntj
>     real colvector o, praw, padj, mx
>     K = rows(t)
>     B = rows(TS)
>     o = order(-abs(t), 1)
>     praw = J(K, 1, .)
>     padj = J(K, 1, .)
>     for (j = 1; j <= K; j++) {
>         i = o[j]
>         cnt = 0
>         cntj = 0
>         for (r = 1; r <= B; r++) {
>             mx = max(abs(TS[r, o[j..K]]))
>             if (mx >= abs(t[i])) cnt++
>             if (abs(TS[r, i]) >= abs(t[i])) cntj++
>         }
>         padj[i] = (cnt + 1) / (B + 1)
>         praw[i] = (cntj + 1) / (B + 1)
>         if (j > 1) padj[i] = max((padj[i], padj[o[j - 1]]))
>     }
>     st_matrix("PR", praw)
>     st_matrix("PRW", padj)
> }

: end
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

