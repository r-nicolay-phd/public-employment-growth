. * =====================================================================================
. * Tabela S2: descritivas das amostras de estimacao
. * =====================================================================================
. capture program drop descrow

. program define descrow
  1.     args v lab
  2.     quietly summ `v', detail
  3.     local m = r(mean)
  4.     local sd = r(sd)
  5.     local med = r(p50)
  6.     local mn = r(min)
  7.     local mx = r(max)
  8.     local n = r(N)
  9.     tempvar mi w
 10.     quietly bysort id: egen double `mi' = mean(`v')
 11.     quietly gen double `w' = `v' - `mi'
 12.     quietly summ `mi' if !missing(`v')
 13.     local sdb = r(sd)
 14.     quietly summ `w'
 15.     local sdw = r(sd)
 16.     foreach x in m sd sdb sdw med mn mx {
 17.         rv_fmt ``x'' %12.2f
 18.         local f`x' "`r(s)'"
 19.     }
 20.     rv_row "`lab'" "`fm'" "`fsd'" "`fsdb'" "`fsdw'" "`fmed'" "`fmn'" "`fmx'" "`=string(`n', "%9.0fc")'"
 21. end

. rv_new, ncol(8) head1("Mean" "SD total" "SD between" "SD within" "Median" "Min" "Max" "N")

