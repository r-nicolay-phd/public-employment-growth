. rv_kv scen_B `B'

. rv_kv scen_C `C'

. rv_kv nitida_dec `nitida_dec'

. rv_kv nit_opra `nit_opra'

. rv_kv nit_mv `nit_mv'

. rv_kv cenario "`cen'"

. di "Cenario: `cen' (A = `A', B = `B', C = `C'; decomposicao nitida = `nitida_dec'; OPRA = `nit_opra'; MV = `nit_mv')"
