. foreach grp in all fed uni {
  2.     local c = cond("`grp'" == "all", "1", cond("`grp'" == "fed", "federal == 1", "federal == 0"))
  3.     foreach meas in gg cg {
  4.         local w = cond("`meas'" == "gg", "wb_m1", "cg_m1")
  5.         reghdfe g `w' $XP i.period if S5_common_GC & `c', absorb(id) vce(cluster id)
  6.         estimates store C_`grp'_`meas'
  7.         local b = _b[`w']
  8.         local se = _se[`w']
  9.         local p = 2 * ttail(e(df_r), abs(`b' / `se'))
 10.         tempvar tg
 11.         egen `tg' = tag(id) if e(sample) & federal == 1
 12.         quietly count if `tg' == 1
 13.         post `P' ("`grp'") ("`meas'") (`b') (`se') (`p') (e(N)) (e(N_clust)) (r(N))
 14.         rv_kv cov_`grp'_`meas'_b `=string(`b', "%9.4f")'
 15.         rv_kv cov_`grp'_`meas'_p `=string(`p', "%9.4f")'
 16.         rv_kv cov_`grp'_`meas'_N `e(N)'
 17.         rv_kv cov_`grp'_`meas'_nc `e(N_clust)'
 18.     }
 19. }
