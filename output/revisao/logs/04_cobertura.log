. * ---------------------------------------------------------------- igualdade dos coeficientes: bootstrap pareado por pais
. capture program drop difgc

. program define difgc, rclass
  1.     * diferenca geral - central; efeitos fixos no identificador `fe' (id, ou bid nas reamostras)
.     args fe
  2.     quietly reghdfe g wb_m1 $XP i.period, absorb(`fe') vce(cluster `fe')
  3.     local b1 = _b[wb_m1]
  4.     quietly reghdfe g cg_m1 $XP i.period, absorb(`fe') vce(cluster `fe')
  5.     return scalar d = `b1' - _b[cg_m1]
  6. end

. tempname B

. postfile `B' str8 grp double(d p lo hi) using "$RINT/cobertura_boot.dta", replace
(file C:\Users\Usuario\Dropbox\Papers\Emprego Público e Crescimento\Estimações/data/interim/revisao/cobertura_boot.dta not found)

. foreach grp in all fed uni {
  2.     local c = cond("`grp'" == "all", "1", cond("`grp'" == "fed", "federal == 1", "federal == 0"))
  3.     preserve
  4.     keep if S5_common_GC & `c'
  5.     tempfile sub
  6.     save `sub'
  7.     difgc id
  8.     local d0 = r(d)
  9.     tempname R
 10.     tempfile rr
 11.     postfile `R' double d using `rr', replace
 12.     set seed 20261017
 13.     forvalues r = 1/999 {
 14.         quietly use `sub', clear
 15.         bsample, cluster(id) idcluster(bid)
 16.         capture difgc bid
 17.         if !_rc post `R' (r(d))
 18.     }
 19.     postclose `R'
 20.     use `rr', clear
 21.     _pctile d, p(2.5 97.5)
 22.     local lo = r(r1)
 23.     local hi = r(r2)
 24.     quietly summ d
 25.     local pp = 2 * normal(-abs(`d0' / r(sd)))
 26.     post `B' ("`grp'") (`d0') (`pp') (`lo') (`hi')
 27.     rv_kv cov_diff_`grp' `=string(`d0', "%9.4f")'
 28.     rv_kv cov_diff_`grp'_p `=string(`pp', "%9.4f")'
 29.     rv_kv cov_diff_`grp'_reps `=_N'
 30.     restore
 31. }
