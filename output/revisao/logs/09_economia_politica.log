. * ---------------------------------------------------------------- projecoes locais por tipo de choque, democracias (H5)
. tempname Q

. postfile `Q' str10 smp int h double(bel seel bot seot pdiff) long(N nc) using "$RINT/ep_lp.dta", replace
(file C:\Users\Usuario\Dropbox\Papers\Emprego Público e Crescimento\Estimações/data/interim/revisao/ep_lp.dta not found)

. gen sel = d_wagebill_real * (election_fixed == 1) if !missing(election_fixed)
(4,054 missing values generated)

. gen sot = d_wagebill_real * (election_fixed == 0) if !missing(election_fixed)
(4,054 missing values generated)

. foreach smp in all dem {
  2.     local c = cond("`smp'" == "all", "per", "per & dem == 1")
  3.     forvalues hh = 0/6 {
  4.         tempvar dy
  5.         quietly gen double `dy' = F`hh'.y100 - L.y100
  6.         quietly xtscc `dy' sel sot i.election_fixed L(1/2).d_wagebill_real L(1/2).g i.year if `c', fe lag($DKLAG)
  7.         quietly test sel = sot
  8.         post `Q' ("`smp'") (`hh') (_b[sel]) (_se[sel]) (_b[sot]) (_se[sot]) (r(p)) (e(N)) (e(N_g))
  9.         if `hh' == 4 {
 10.             lincom sel - sot
 11.             rv_kv eplp_`smp'_h4_diff `=string(r(estimate), "%9.4f")'
 12.             rv_kv eplp_`smp'_h4_p `=string(r(p), "%9.4f")'
 13.             rv_kv eplp_`smp'_h4_se `=string(r(se), "%9.4f")'
 14.         }
 15.         drop `dy'
 16.     }
 17. }

