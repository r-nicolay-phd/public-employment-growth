. * Extensoes: interacoes da folha (t_p - 1) com caracteristicas politicas (t_p - 1), controles de T3
. * =====================================================================================
. use "$RINT/p5_rv.dta", clear

. keep if micro == 0
(261 observations deleted)

. xtset id period

Panel variable: id (strongly balanced)
 Time variable: period, 0 to 8
         Delta: 1 unit

. global XP "lny0 hc_m1 inv_m1 open_m1 infl_m1 popg_m1 ctot_g_m1"

. tempname E

. postfile `E' str20 v str70 lab double(bi sei pi bmain) long(N nc) using "$RINT/ep_ext.dta", replace
(file C:\Users\Usuario\Dropbox\Papers\Emprego Público e Crescimento\Estimações/data/interim/revisao/ep_ext.dta not found)

. foreach v in exec_left maj frac demage union_density clientelism_prog impartial {
  2.     capture drop zc wbxz
  3.     quietly summ `v'_m1 if !missing(g, wb_m1, lny0, hc_m1, inv_m1, open_m1, infl_m1, popg_m1, ctot_g_m1)
  4.     gen zc = `v'_m1 - r(mean)
  5.     gen wbxz = wb_m1 * zc
  6.     capture noisily reghdfe g wb_m1 zc wbxz $XP i.period, absorb(id) vce(cluster id)
  7.     if _rc continue
  8.     estimates store EX_`v'
  9.     local lab = cond("`v'" == "exec_left", "Left-wing executive (DPI)", cond("`v'" == "maj", "Government majority, share of seats (DPI)", ///
>         cond("`v'" == "frac", "Legislative fractionalization (DPI)", cond("`v'" == "demage", "Age of democracy, years (V-Dem)", ///
>         cond("`v'" == "union_density", "Trade union density, % (ILOSTAT)", cond("`v'" == "clientelism_prog", "Programmatic (vs clientelistic) linkages (V-Dem)", ///
>         "Rigorous and impartial administration (V-Dem)"))))))
 10.     post `E' ("`v'") ("`lab'") (_b[wbxz]) (_se[wbxz]) (2 * ttail(e(df_r), abs(_b[wbxz] / _se[wbxz]))) (_b[wb_m1]) (e(N)) (e(N_clust))
 11.     rv_kv ext_`v'_bi `=string(_b[wbxz], "%9.4f")'
 12.     rv_kv ext_`v'_pi `=string(2 * ttail(e(df_r), abs(_b[wbxz] / _se[wbxz])), "%9.4f")'
 13. }
