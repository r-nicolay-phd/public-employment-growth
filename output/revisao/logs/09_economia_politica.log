. 
. use "$RINT/anual_rv.dta", clear

. keep if micro == 0 & inrange(year, 1990, 2023)
(4,926 observations deleted)

. xtset id year

Panel variable: id (strongly balanced)
 Time variable: year, 1990 to 2023
         Delta: 1 unit

. gen L_g = L.g
(336 missing values generated)

. * DPI termina em 2020
. gen byte per = inrange(year, 1996, 2020)

. quietly summ merit_l1 if per & !missing(d_wagebill_real), detail

. gen byte mhi = merit_l1 > r(p50) if !missing(merit_l1)
(212 missing values generated)

. gen efxm = election_fixed * mhi
(982 missing values generated)

. 
. tempname P

. postfile `P' str10 smp double(b se p pboot Feff Fkp) str40 arci long(N nc) using "$RINT/ep_first.dta", replace
(file C:\Users\Usuario\Dropbox\Papers\Emprego Público e Crescimento\Estimações/data/interim/revisao/ep_first.dta not found)

. foreach smp in all dem new old {
  2.     local c = cond("`smp'" == "all", "per", cond("`smp'" == "dem", "per & dem == 1", cond("`smp'" == "new", "per & dem_new == 1", "per & dem == 1 & dem_new == 0")))
  3.     reghdfe d_wagebill_real election_fixed L_g i.year if `c', absorb(id) vce(cluster id)
  4.     estimates store EP1_`smp'
  5.     local b = _b[election_fixed]
  6.     local se = _se[election_fixed]
  7.     local p = 2 * ttail(e(df_r), abs(`b' / `se'))
  8.     local Feff = (`b' / `se')^2
  9.     local N = e(N)
 10.     local nc = e(N_clust)
 11.     rv_boot election_fixed
 12.     local pb = r(p)
 13.     * segundo estagio (so diagnostico se o instrumento for fraco) e Kleibergen-Paap
.     capture noisily ivreghdfe g (d_wagebill_real = election_fixed) balance_gdp L_g i.year if `c', absorb(id) cluster(id)
 14.     local Fkp = cond(_rc, ., e(widstat))
 15.     * intervalo de Anderson-Rubin (weakiv), robusto a instrumento fraco
.     local ar ""
 16.     capture noisily weakiv ivreg2 g (d_wagebill_real = election_fixed) balance_gdp L_g i.year i.id if `c', cluster(id)
 17.     if !_rc {
 18.         local ar "`e(ar_cset)'"
 19.         local ar : subinstr local ar "  ...  ]" " +inf)"
 20.         local ar : subinstr local ar "[  ...  " "(−inf"
 21.     }
 22.     post `P' ("`smp'") (`b') (`se') (`p') (`pb') (`Feff') (`Fkp') ("`ar'") (`N') (`nc')
 23.     rv_kv ep_`smp'_b `=string(`b', "%9.4f")'
 24.     rv_kv ep_`smp'_p `=string(`p', "%9.4f")'
 25.     rv_kv ep_`smp'_pboot `=string(`pb', "%9.4f")'
 26.     rv_kv ep_`smp'_Feff `=string(`Feff', "%9.2f")'
 27.     rv_kv ep_`smp'_N `N'
 28. }
