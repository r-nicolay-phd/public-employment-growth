. 
. global XD "lny0 hc_tp inv open infl popg ctot_g"

. global XP "lny0 hc_m1 inv_m1 open_m1 infl_m1 popg_m1 ctot_g_m1"

. 
. * =====================================================================================
. * A. Verificacao de Bond: MQO, EF, S-GMM e BC-FE na mesma amostra (S5_bond)
. * =====================================================================================
. use "$RINT/p5_rv.dta", clear

. keep if micro == 0
(261 observations deleted)

. xtset id period

Panel variable: id (strongly balanced)
 Time variable: period, 0 to 8
         Delta: 1 unit

. quietly tab period, gen(pd)

. drop pd1

. tempname P

. postfile `P' str6 tim str6 est double(rho serho b se) long(N nc) using "$RINT/bond.dta", replace

. foreach tim in draft T3 {
  2.     local w = cond("`tim'" == "draft", "wb_tp", "wb_m1")
  3.     local X = cond("`tim'" == "draft", "$XD", "$XP")
  4.     local exo = cond("`tim'" == "draft", "hc_tp open infl popg ctot_g", "hc_m1 open_m1 infl_m1 popg_m1 ctot_g_m1")
  5.     local endo = cond("`tim'" == "draft", "`w' inv lny0", "`w' lny0")
  6.     if "`tim'" == "T3" local exo "`exo' inv_m1"
  7.     * amostras proprias e intersecao
.     quietly regress g L_g `w' `X' pd*, vce(cluster id)
  8.     gen byte s_ols = e(sample)
  9.     quietly reghdfe g L_g `w' `X' i.period, absorb(id) vce(cluster id)
 10.     gen byte s_fe = e(sample)
 11.     quietly xtabond2 g L_g `w' `X' pd*, gmm(L_g, lag(1 2) collapse) gmm(`endo', lag(2 3) collapse) iv(`exo' pd*) twostep robust small
 12.     gen byte s_gmm = e(sample)
 13.     quietly xtdpdbc g `w' `X', fe lags(1) teffects vce(robust) small
 14.     gen byte s_bc = e(sample)
 15.     gen byte S5_bond_`tim' = s_ols & s_fe & s_gmm & s_bc
 16.     count if S5_bond_`tim'
 17.     rv_kv bond_`tim'_N `r(N)'
 18.     foreach k in ols fe gmm bc {
 19.         count if s_`k'
 20.         rv_kv bond_`tim'_own_`k' `r(N)'
 21.     }
 22.     drop s_ols s_fe s_gmm s_bc
 23.     * os quatro estimadores na amostra comum
.     regress g L_g `w' `X' pd* if S5_bond_`tim', vce(cluster id)
 24.     post `P' ("`tim'") ("ols") (_b[L_g]) (_se[L_g]) (_b[`w']) (_se[`w']) (e(N)) (e(N_clust))
 25.     estimates store BD_`tim'_ols
 26.     reghdfe g L_g `w' `X' i.period if S5_bond_`tim', absorb(id) vce(cluster id)
 27.     post `P' ("`tim'") ("fe") (_b[L_g]) (_se[L_g]) (_b[`w']) (_se[`w']) (e(N)) (e(N_clust))
 28.     estimates store BD_`tim'_fe
 29.     xtabond2 g L_g `w' `X' pd* if S5_bond_`tim', gmm(L_g, lag(1 2) collapse) gmm(`endo', lag(2 3) collapse) iv(`exo' pd*) twostep robust small
 30.     post `P' ("`tim'") ("gmm") (_b[L_g]) (_se[L_g]) (_b[`w']) (_se[`w']) (e(N)) (e(N_g))
 31.     rv_kv bond_`tim'_gmm_hansen `=string(e(hansenp), "%6.3f")'
 32.     rv_kv bond_`tim'_gmm_ar2 `=string(e(ar2p), "%6.3f")'
 33.     rv_kv bond_`tim'_gmm_j `e(j)'
 34.     estimates store BD_`tim'_gmm
 35.     xtdpdbc g `w' `X' if S5_bond_`tim', fe lags(1) teffects vce(robust) small
 36.     post `P' ("`tim'") ("bc") (_b[L.g]) (_se[L.g]) (_b[`w']) (_se[`w']) (e(N)) (e(N_g))
 37.     estimates store BD_`tim'_bc
 38. }
