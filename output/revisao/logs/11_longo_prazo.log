. postclose `L'

. mata: mata clear

. do "$ROOT/code/revisao/00_setup.do"

. * 00_setup.do -- revisao EJPE: caminhos, semente, pacotes, estilo grafico e rotinas comuns
. * Chamado no topo de todo do-file de code/revisao/. Nao instala nada (ver 00_instala.do).
. version 17

. clear all

. set more off

. set seed 20261017

. set sortseed 20261017

. set maxvar 30000


. set linesize 200

. if "$ROOT" == "" global ROOT "`c(pwd)'"

. global RAW     "$ROOT/data/raw"

. global FINAL   "$ROOT/data/final"

. global RINT    "$ROOT/data/interim/revisao"

. global RTAB    "$ROOT/output/revisao/tables"

. global RFIG    "$ROOT/output/revisao/figures"

. global RLOG    "$ROOT/output/revisao/logs"

. global RCAP    "$ROOT/output/revisao/logs/captions"

. global DOCS    "$ROOT/docs"

. foreach d in "$ROOT/data/interim" "$RINT" "$ROOT/output/revisao" "$RTAB" "$RFIG" "$RLOG" "$RCAP" {
  2.     capture mkdir "`d'"
  3. }

. * pacotes comunitarios do projeto (instalados por 00_instala.do)
. sysdir set PLUS "$ROOT/ado/plus"

. adopath ++ "$ROOT/ado/plus"
  [1]              "C:\Users\Usuario\Dropbox\Papers\Emprego Público e Crescimento\Estimações/ado/plus"
  [2]  (BASE)      "C:\Program Files\Stata17\ado\base/"
  [3]  (SITE)      "C:\Program Files\Stata17\ado\site/"
  [4]              "."
  [5]  (PERSONAL)  "C:\Users\Usuario\ado\personal/"
  [6]  (PLUS)      "C:\Users\Usuario\Dropbox\Papers\Emprego Público e Crescimento\Estimações/ado/plus/"
  [7]  (OLDPLACE)  "c:\ado/"

. foreach c in reghdfe ftools ivreghdfe ivreg2 ranktest xtscc xtabond2 xtdpdgmm xtdpdbc boottest rwolf2 ///
>     weakivtest weakiv twostepweakiv xthenreg xthreg interflex xtpmg xtdcce2 xtcd2 bma wals estout coefplot {
  2.     capture which `c'
  3.     if _rc {
  4.         di as error "pacote ausente: `c' (rodar code/revisao/00_instala.do)"
  5.         exit 199
  6.     }
  7. }

. 
. * ---------------------------------------------------------------- estilo grafico (impressao em preto e branco)
. set scheme plotplain

. graph set window fontface "Arial"

. graph set ps fontface "Arial"

. global GOPT "graphregion(color(white) margin(small)) plotregion(color(white) lcolor(none)) ylabel(, nogrid labsize(8pt) angle(horizontal)) xlabel(, labsize(8pt)) legend(size(8pt) region(lcolor(none)
> ))"

. * defasagem maxima de Driscoll-Kraay usada em todo o painel anual (T = 28: floor(4 (28/100)^(2/9)) = 3)
. global DKLAG 3

. 
. * ---------------------------------------------------------------- registro chave-valor (numeros do relatorio)
. * rv_kv chave valor  -> acrescenta "chave,valor" em $RINT/kv.csv (lido pelos relatorios; nada e digitado)
. capture program drop rv_kv

. program define rv_kv
  1.     args key val
  2.     tempname F
  3.     capture confirm file "$RINT/kv.csv"
  4.     if _rc {
  5.         file open `F' using "$RINT/kv.csv", write text replace
  6.         file write `F' "key,value" _n
  7.     }
  8.     else file open `F' using "$RINT/kv.csv", write text append
  9.     file write `F' `"`key',`val'"' _n
 10.     file close `F'
 11. end

. 
. * ---------------------------------------------------------------- filtros de tendencia do log do PIB real
. * Hamilton (2018): tendencia em t = projecao de y_t em y_{t-H}, ..., y_{t-H-k+1} (por pais; predeterminada)
. capture program drop rv_hamilton

. program define rv_hamilton
  1.     syntax varname, gen(name) [H(integer 2) K(integer 2) minobs(integer 10)]
  2.     quietly gen double `gen' = .
  3.     quietly levelsof id, local(ids)
  4.     local last = `h' + `k' - 1
  5.     foreach i of local ids {
  6.         capture quietly regress `varlist' L(`h'/`last').`varlist' if id == `i'
  7.         if !_rc & e(N) >= `minobs' {
  8.             tempvar p
  9.             quietly predict double `p' if id == `i' & e(sample), xb
 10.             quietly replace `gen' = `p' if id == `i'
 11.             drop `p'
 12.         }
 13.     }
 14. end

. 
. * HP unilateral (recursivo): para cada t, HP(lambda) na janela [inicio, t] e guarda so o ultimo ponto
. capture program drop rv_hp1s

. program define rv_hp1s
  1.     syntax varname, gen(name) [lambda(real 6.25) minobs(integer 8)]
  2.     quietly gen double `gen' = .
  3.     sort id year
  4.     mata: _hp1s("`varlist'", "id", "`gen'", `lambda', `minobs')
  5. end

. mata:
------------------------------------------------- mata (type end to exit) ------------------------------------------------------------------------------------------------------------------------------
: void _hp1s(string scalar yv, string scalar idv, string scalar outv, real scalar lambda, real scalar minT)
> {
>     real colvector y, id, out, sel, ys, tr
>     real scalar i, n, t, T
>     real matrix D, A
>     y = st_data(., yv)
>     id = st_data(., idv)
>     out = J(rows(y), 1, .)
>     for (i = min(id); i <= max(id); i++) {
>         sel = selectindex((id :== i) :& (y :< .))
>         T = rows(sel)
>         if (T < minT) continue
>         for (t = minT; t <= T; t++) {
>             ys = y[sel[1..t]]
>             D = J(t - 2, t, 0)
>             for (n = 1; n <= t - 2; n++) D[n, (n, n + 1, n + 2)] = (1, -2, 1)
>             A = I(t) + lambda * D' * D
>             tr = lusolve(A, ys)
>             out[sel[t]] = tr[t]
>         }
>     }
>     st_store(., outv, out)
> }

: end
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

. 
. * HP bilateral (mesmo do draft 7), para comparacao
. capture program drop rv_hp2s

. program define rv_hp2s
  1.     syntax varname, gen(name) [lambda(real 6.25) minobs(integer 8)]
  2.     quietly gen double `gen' = .
  3.     sort id year
  4.     mata: _hp2s("`varlist'", "id", "`gen'", `lambda', `minobs')
  5. end

. mata:
------------------------------------------------- mata (type end to exit) ------------------------------------------------------------------------------------------------------------------------------
: void _hp2s(string scalar yv, string scalar idv, string scalar outv, real scalar lambda, real scalar minT)
> {
>     real colvector y, id, out, sel, ys
>     real scalar i, n, T
>     real matrix D, A
>     y = st_data(., yv)
>     id = st_data(., idv)
>     out = J(rows(y), 1, .)
>     for (i = min(id); i <= max(id); i++) {
>         sel = selectindex((id :== i) :& (y :< .))
>         T = rows(sel)
>         if (T < minT) continue
>         ys = y[sel]
>         D = J(T - 2, T, 0)
>         for (n = 1; n <= T - 2; n++) D[n, (n, n + 1, n + 2)] = (1, -2, 1)
>         A = I(T) + lambda * D' * D
>         out[sel] = lusolve(A, ys)
>     }
>     st_store(., outv, out)
> }

: end
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

. 
. * ---------------------------------------------------------------- tabelas (grade em Mata -> .tex booktabs e .docx)
. * rv_new, ncol() head1() head2()       zera a grade
. * rv_row "rotulo" "c1" "c2" ...        linha livre
. * rv_mid                               linha horizontal apos a ultima linha
. * rv_bse "rotulo" b se p [b se p ...]  coeficiente com estrelas e EP abaixo (p = . -> normal)
. * rv_estrow "rotulo", models() vars()  coeficientes de estimativas guardadas (uma variavel por modelo ou uma so)
. * rv_stat "rotulo", models() stat() [fmt()]
. * rv_out arquivo, title() notes() [landscape]
. capture program drop rv_new

. program define rv_new
  1.     syntax , ncol(integer) [head1(string asis) head2(string asis) head3(string asis)]
  2.     mata: RV = J(0, `ncol' + 1, ""); RVH = J(0, `ncol' + 1, ""); RVMID = J(0, 1, .)
  3.     if `"`head1'"' != "" mata: RVH = RVH \ ("" , _rvuntok(tokens(`"`head1'"')))
  4.     if `"`head2'"' != "" mata: RVH = RVH \ ("" , _rvuntok(tokens(`"`head2'"')))
  5.     if `"`head3'"' != "" mata: RVH = RVH \ ("" , _rvuntok(tokens(`"`head3'"')))
  6. end

. 
. capture program drop rv_row

. program define rv_row
  1.     gettoken lab rest : 0
  2.     local cells ""
  3.     while `"`rest'"' != "" {
  4.         gettoken c rest : rest
  5.         local cells `"`cells' `"`c'"'"'
  6.     }
  7.     mata: _rvadd(`"`lab'"', `"`cells'"')
  8. end

. 
. capture program drop rv_mid

. program define rv_mid
  1.     mata: RVMID = RVMID \ rows(RV)
  2. end

. 
. * formatacao de numero: sinal de menos U+2212, 3 casas (ou fmt), estrelas por p
. capture program drop rv_fmt

. program define rv_fmt, rclass
  1.     args x fmt p
  2.     if "`fmt'" == "" local fmt "%12.3f"
  3.     if missing(`x') {
  4.         return local s ""
  5.         exit
  6.     }
  7.     local s : display `fmt' `x'
  8.     local s = strtrim("`s'")
  9.     if substr("`s'", 1, 1) == "-" local s = uchar(8722) + substr("`s'", 2, .)
 10.     if "`p'" != "" & "`p'" != "." {
 11.         if `p' < 0.01 local s "`s'***"
 12.         else if `p' < 0.05 local s "`s'**"
 13.         else if `p' < 0.10 local s "`s'*"
 14.     }
 15.     return local s "`s'"
 16. end

. 
. capture program drop rv_bse

. program define rv_bse
  1.     gettoken lab rest : 0
  2.     local brow ""
  3.     local srow ""
  4.     while `"`rest'"' != "" {
  5.         gettoken b rest : rest
  6.         gettoken se rest : rest
  7.         gettoken p rest : rest
  8.         if "`b'" == "" | "`b'" == "." {
  9.             local brow `"`brow' """'
 10.             local srow `"`srow' """'
 11.             continue
 12.         }
 13.         if "`p'" == "." | "`p'" == "" local p = 2 * normal(-abs(`b' / `se'))
 14.         rv_fmt `b' %12.3f `p'
 15.         local bs "`r(s)'"
 16.         rv_fmt `se' %12.3f
 17.         local ss "(`r(s)')"
 18.         local brow `"`brow' "`bs'""'
 19.         local srow `"`srow' "`ss'""'
 20.     }
 21.     mata: _rvadd(`"`lab'"', `"`brow'"')
 22.     mata: _rvadd("", `"`srow'"')
 23. end

. 
. capture program drop rv_estrow

. program define rv_estrow
  1.     * rv_estrow "rotulo", models(m1 m2) vars(v) [noserow]
.     gettoken lab 0 : 0, parse(",")
  2.     syntax , models(string) vars(string) [noSErow dfnormal]
  3.     local nm : word count `models'
  4.     local nv : word count `vars'
  5.     local brow ""
  6.     local srow ""
  7.     forvalues j = 1/`nm' {
  8.         local m : word `j' of `models'
  9.         local v : word `=cond(`nv' == 1, 1, `j')' of `vars'
 10.         if "`m'" == "." | "`v'" == "." {
 11.             local brow `"`brow' """'
 12.             local srow `"`srow' """'
 13.             continue
 14.         }
 15.         quietly estimates restore `m'
 16.         local cn : colnames e(b)
 17.         local found : list v in cn
 18.         capture local b = _b[`v']
 19.         if _rc | !`found' {
 20.             local brow `"`brow' """'
 21.             local srow `"`srow' """'
 22.             continue
 23.         }
 24.         local se = _se[`v']
 25.         if `se' == 0 | missing(`se') {
 26.             local brow `"`brow' """'
 27.             local srow `"`srow' """'
 28.             continue
 29.         }
 30.         local df = e(df_r)
 31.         if missing(`df') | "`dfnormal'" != "" local p = 2 * normal(-abs(`b' / `se'))
 32.         else local p = 2 * ttail(`df', abs(`b' / `se'))
 33.         rv_fmt `b' %12.3f `p'
 34.         local brow `"`brow' "`r(s)'""'
 35.         rv_fmt `se' %12.3f
 36.         local srow `"`srow' "(`r(s)')""'
 37.     }
 38.     mata: _rvadd(`"`lab'"', `"`brow'"')
 39.     if "`serow'" != "noserow" mata: _rvadd("", `"`srow'"')
 40. end

. 
. capture program drop rv_stat

. program define rv_stat
  1.     gettoken lab 0 : 0, parse(",")
  2.     syntax , models(string) stat(string) [fmt(string)]
  3.     if "`fmt'" == "" local fmt "%12.0fc"
  4.     local row ""
  5.     foreach m of local models {
  6.         if "`m'" == "." {
  7.             local row `"`row' """'
  8.             continue
  9.         }
 10.         quietly estimates restore `m'
 11.         local x = e(`stat')
 12.         rv_fmt `x' `fmt'
 13.         local row `"`row' "`r(s)'""'
 14.     }
 15.     mata: _rvadd(`"`lab'"', `"`row'"')
 16. end

. 
. capture program drop rv_out

. program define rv_out
  1.     syntax anything(name=fname), title(string) [notes(string) landscape]
  2.     local fname `fname'
  3.     mata: _rvtex("$RTAB/`fname'.tex", `"`title'"', `"`notes'"', "`fname'")
  4.     mata: st_local("nr", strofreal(rows(RVH) + rows(RV))); st_local("nc", strofreal(cols(RV)))
  5.     putdocx clear
  6.     putdocx begin, pagesize(A4) `=cond("`landscape'" != "", "landscape", "")' font("Times New Roman", 9)
  7.     putdocx paragraph, spacing(after, 4pt)
  8.     putdocx text (`"`title'"'), bold
  9.     putdocx table T = (`nr', `nc'), border(all, nil) border(top, single) border(bottom, single) layout(autofitcontents)
 10.     mata: _rvdocx()
 11.     if `"`notes'"' != "" {
 12.         putdocx paragraph, spacing(before, 4pt)
 13.         putdocx text ("Notes: "), italic font("Times New Roman", 8)
 14.         putdocx text (`"`notes'"'), font("Times New Roman", 8)
 15.     }
 16.     putdocx save "$RTAB/`fname'.docx", replace
 17.     tempname C
 18.     file open `C' using "$RCAP/`fname'.txt", write replace text
 19.     file write `C' `"`title'"' _n `"`notes'"' _n
 20.     file close `C'
 21.     di as text "tabela gravada: $RTAB/`fname'.{tex,docx}"
 22. end

