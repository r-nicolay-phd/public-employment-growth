. * =====================================================================================
. * B. Longo prazo: PMG, MG, DFE, CCE-MG, CS-ARDL e CS-DL (painel anual, paises com 20 anos ou mais)
. * =====================================================================================
. use "$RINT/anual_rv.dta", clear

. keep if micro == 0 & inrange(year, 1993, 2023)
(5,430 observations deleted)

. xtset id year

Panel variable: id (strongly balanced)
 Time variable: year, 1993 to 2023
         Delta: 1 unit

. gen wbL = L.wb
(3,303 missing values generated)

. gen wbH = L.wb_ham
(3,303 missing values generated)

. gen byte okc = !missing(g, L.g, L2.g, wbL, L.wbL, L2.wbL, wbH, L.wbH, L2.wbH, inv, open, infl, popg) & year >= 1996

. bysort id: egen nyc = total(okc)

. keep if nyc >= 20
(3,875 observations deleted)

. xtset id year

Panel variable: id (strongly balanced)
 Time variable: year, 1993 to 2023
         Delta: 1 unit

. tempname L

. postfile `L' str4 w str10 m double(b se) long(N ng) double(hp) using "$RINT/longo.dta", replace

. foreach W in wbL wbH {
  2.     capture drop X
  3.     gen X = `W'
  4.     foreach est in pmg mg dfe {
  5.         capture noisily xtpmg d.g d.X d.inv d.open d.infl d.popg if okc, lr(l.g X inv open infl popg) ec(ec) replace `est'
  6.         if _rc continue
  7.         estimates store LP_`W'_`est'
  8.         quietly count if e(sample)
  9.         local N = r(N)
 10.         quietly levelsof id if e(sample)
 11.         post `L' ("`W'") ("`est'") (_b[ec:X]) (_se[ec:X]) (`N') (r(r)) (.)
 12.     }
 13.     capture noisily hausman LP_`W'_mg LP_`W'_pmg, sigmamore
 14.     local hp = cond(_rc, ., r(p))
 15.     rv_kv lr_`W'_hausman `=string(`hp', "%6.3f")'
 16.     * CCE-MG estatico (folha defasada e controles, medias transversais)
.     capture noisily xtdcce2 g X inv open infl popg if okc, cr(g X inv open infl popg) cr_lags(0)
 17.     if !_rc post `L' ("`W'") ("ccemg") (_b[X]) (_se[X]) (e(N)) (e(N_g)) (.)
 18.     capture noisily xtdcce2 g if okc, lr(L.g X L.X inv open infl popg) lr_options(ardl) cr(g X inv open infl popg) cr_lags(0)
 19.     if !_rc post `L' ("`W'") ("csardl") (_b[lr_X]) (_se[lr_X]) (e(N)) (e(N_g)) (.)
 20.     capture noisily xtdcce2 g X d.X inv if okc, cr(g X inv) cr_lags(2)
 21.     if !_rc post `L' ("`W'") ("csdl") (_b[X]) (_se[X]) (e(N)) (e(N_g)) (.)
 22. }
