. * ---------------------------------------------------------------- figuras
. capture program drop rv_fig

. program define rv_fig
  1.     * rv_fig nome, width(90|190) height(mm): PDF vetorial e PNG a 600 dpi
.     syntax anything(name=fname), width(integer) height(integer)
  2.     local fname `fname'
  3.     local win = `width' / 25.4
  4.     local hin = `height' / 25.4
  5.     graph display, xsize(`win') ysize(`hin')
  6.     graph export "$RFIG/`fname'.pdf", replace
  7.     graph export "$RFIG/`fname'.png", replace width(`=round(`win' * 600)')
  8.     graph export "$RFIG/`fname'.eps", replace as(eps)
  9.     di as text "figura gravada: $RFIG/`fname'.{pdf,png,eps} (`width' x `height' mm)"
 10. end

. 
. * ---------------------------------------------------------------- wild cluster bootstrap padronizado
. * rv_boot var [, reps(9999) weight(webb)]: depois de reghdfe/regress com vce(cluster id); devolve r(p), r(lo), r(hi)
. capture program drop rv_boot

. program define rv_boot, rclass
  1.     syntax anything(name=v) [, reps(integer 9999) weight(string)]
  2.     if "`weight'" == "" local weight "webb"
  3.     quietly boottest `v', reps(`reps') weighttype(`weight') seed(20261017) nograph
  4.     return scalar p = r(p)
  5.     capture matrix CI = r(CI)
  6.     if !_rc {
  7.         return scalar lo = CI[1, 1]
  8.         return scalar hi = CI[1, 2]
  9.     }
 10. end

. 
