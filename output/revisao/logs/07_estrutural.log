. global XP "lny0 hc_m1 inv_m1 open_m1 infl_m1 popg_m1 ctot_g_m1"

. 
. * =====================================================================================
. * A. Especificacao preferida (T3) com cada alteracao
. * =====================================================================================
. use "$RINT/p5_rv.dta", clear

. keep if micro == 0
(261 observations deleted)

. xtset id period

Panel variable: id (strongly balanced)
 Time variable: period, 0 to 8
         Delta: 1 unit

. merge 1:1 id period using "$RINT/amostra_T3.dta", keep(master match) nogen
(label id already defined)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                             1,512  
    -----------------------------------------

. * painel balanceado: paises presentes em todos os periodos da amostra de T3
. bysort id: egen nT3 = total(S5_T3)

. quietly summ nT3

. gen byte balanced = nT3 == r(max)

. gen byte excl_euro = euro_0813_p == 1 & year0 == 2009

. tempname P

. postfile `P' str12 spec str70 lab double(b se p) long(N nc) using "$RINT/estrutural.dta", replace

. capture program drop est5

. program define est5
  1.     args P spec lab cond extra absorb
  2.     if "`absorb'" == "" local absorb "id"
  3.     reghdfe g wb_m1 $XP `extra' i.period if `cond', absorb(`absorb') vce(cluster id)
  4.     estimates store S_`spec'
  5.     post `P' ("`spec'") ("`lab'") (_b[wb_m1]) (_se[wb_m1]) (2 * ttail(e(df_r), abs(_b[wb_m1] / _se[wb_m1]))) (e(N)) (e(N_clust))
  6.     rv_kv str_`spec'_b `=string(_b[wb_m1], "%12.8f")'
  7.     rv_kv str_`spec'_p `=string(2 * ttail(e(df_r), abs(_b[wb_m1] / _se[wb_m1])), "%9.4f")'
  8.     rv_kv str_`spec'_N `e(N)'
  9. end

