. * =====================================================================================
. * B. Projecoes locais por regime de merito (D3 do draft 7) com cada alteracao
. * =====================================================================================
. use "$RINT/anual_rv.dta", clear

. keep if micro == 0 & inrange(year, 1990, 2023)
(4,926 observations deleted)

. xtset id year

Panel variable: id (strongly balanced)
 Time variable: year, 1990 to 2023
         Delta: 1 unit

. gen byte smp = !missing(d_wagebill_real, L.d_wagebill_real, L2.d_wagebill_real, L.g, L2.g) & inrange(year, 1996, 2023)

. quietly summ merit_l1 if smp, detail

. local med = r(p50)

. gen byte mhi = merit_l1 > `med' if !missing(merit_l1)
(212 missing values generated)

. gen shi = d_wagebill_real * (mhi == 1) if !missing(mhi)
(3,801 missing values generated)

. gen slo = d_wagebill_real * (mhi == 0) if !missing(mhi)
(3,801 missing values generated)

. gen byte excl_euro = euro & inrange(year, 2008, 2013)

. bysort id: egen nyr = total(smp & !missing(mhi))

. quietly summ nyr

. gen byte balanced = nyr == r(max)

. gen oldage_l1 = L.oldage_dep
(168 missing values generated)

. gen healthedu_l1 = L.health_edu_share
(4,380 missing values generated)

. gen healthcofog_l1 = L.health_edu_cofog
(4,217 missing values generated)

. tempname Q

. postfile `Q' str12 spec int h double(bhi sehi blo selo pdiff) long(N nc nep_hi nc_hi) using "$RINT/estrutural_lp.dta", replace

. foreach spec in base trend regyear oldage healthedu healthcofog noeuro balanced crisis all {
  2.     local extra ""
  3.     local cond "inrange(year, 1996, 2023)"
  4.     if "`spec'" == "trend" local extra "i.id#c.year"
  5.     if "`spec'" == "regyear" local extra "i.region_id#i.year"
  6.     if "`spec'" == "oldage" local extra "oldage_l1"
  7.     if "`spec'" == "healthedu" local extra "healthedu_l1"
  8.     if "`spec'" == "healthcofog" local extra "healthcofog_l1"
  9.     if "`spec'" == "noeuro" local cond "`cond' & !excl_euro"
 10.     if "`spec'" == "balanced" local cond "`cond' & balanced"
 11.     if "`spec'" == "crisis" local extra "crisis_bank"
 12.     if "`spec'" == "all" {
 13.         local extra "i.id#c.year i.region_id#i.year oldage_l1 healthedu_l1 crisis_bank"
 14.         local cond "`cond' & !excl_euro"
 15.     }
 16.     forvalues hh = 0/6 {
 17.         tempvar dy
 18.         quietly gen double `dy' = F`hh'.y100 - L.y100
 19.         capture quietly xtscc `dy' shi slo i.mhi L(1/2).d_wagebill_real L(1/2).g `extra' i.year if `cond', fe lag($DKLAG)
 20.         if _rc {
 21.             post `Q' ("`spec'") (`hh') (.) (.) (.) (.) (.) (.) (.) (.) (.)
 22.             drop `dy'
 23.             continue
 24.         }
 25.         quietly test shi = slo
 26.         local pd = r(p)
 27.         * episodios (pais-anos com choque diferente de zero) e paises no regime de merito alto
.         quietly count if e(sample) & mhi == 1 & d_wagebill_real != 0
 28.         local nep = r(N)
 29.         tempvar tg
 30.         quietly egen `tg' = tag(id) if e(sample) & mhi == 1
 31.         quietly count if `tg' == 1
 32.         local nch = r(N)
 33.         post `Q' ("`spec'") (`hh') (_b[shi]) (_se[shi]) (_b[slo]) (_se[slo]) (`pd') (e(N)) (e(N_g)) (`nep') (`nch')
 34.         drop `dy' `tg'
 35.     }
 36. }

. postclose `Q'

. use "$RINT/estrutural_lp.dta", clear

. list if inlist(h, 4, 5), noobs sepby(spec)

