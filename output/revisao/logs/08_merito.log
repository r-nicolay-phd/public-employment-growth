. * =====================================================================================
. * Figura 6: efeito marginal ao longo do merito (linear, faixas), com histograma e N
. * =====================================================================================
. use "$RINT/h3_dados.dta", clear

. estimates restore H3
(results H3 are active now)

. local df = e(df_r)

. local N = e(N)

. quietly summ meritc if sM

. local lo0 = r(min)

. local hi0 = r(max)

. preserve

. clear

. set obs 61
Number of observations (_N) was 0, now 61.

. gen z = `lo0' + (`hi0' - `lo0') * (_n - 1) / 60

. gen me = .
(61 missing values generated)

. gen lo = .
(61 missing values generated)

. gen hi = .
(61 missing values generated)

. forvalues i = 1/61 {
  2.     local zz = z[`i']
  3.     quietly lincom wb_m1 + `zz' * wbxm
  4.     quietly replace me = r(estimate) in `i'
  5.     quietly replace lo = r(estimate) - invttail(`df', 0.025) * r(se) in `i'
  6.     quietly replace hi = r(estimate) + invttail(`df', 0.025) * r(se) in `i'
  7. }

. gen zr = z + `mbar'

. tempfile ME

. save `ME'
file C:\Users\Usuario\AppData\Local\Temp\ST_64e0_00000t.tmp saved as .dta format

. use "$RINT/h3_bins.dta", clear

. gen blo = me - invttail(`df', 0.025) * se

. gen bhi = me + invttail(`df', 0.025) * se

. append using `ME'

. append using "$RINT/h3_kernel.dta"

. twoway (rarea lo hi zr, fcolor(gs14) lcolor(gs8) lpattern(dash) lwidth(vthin)) (line me zr, lcolor(black)) ///
