. * ---------------------------------------------------------------- HMX: tercis com teste de Wald de linearidade
. _pctile meritc if sM, p(33.333 66.667)

. local c1 = r(r1)

. local c2 = r(r2)

. gen byte bin = cond(meritc <= `c1', 1, cond(meritc <= `c2', 2, 3)) if sM
(1,162 missing values generated)

. tempname B

. postfile `B' int bin double(zmed me se) long(n) using "$RINT/h3_bins.dta", replace

. forvalues k = 1/3 {
  2.     quietly summ meritc if bin == `k', detail
  3.     local z`k' = r(p50)
  4.     gen byte G`k' = bin == `k'
  5.     gen DG`k' = wb_m1 * G`k'
  6.     gen ZG`k' = (meritc - `z`k'') * G`k'
  7.     gen DZG`k' = wb_m1 * (meritc - `z`k'') * G`k'
  8. }
