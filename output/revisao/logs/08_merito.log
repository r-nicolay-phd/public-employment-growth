. * =====================================================================================
. * Limiares: Seo e Shin (2016) e Hansen (1999), painel anual balanceado, folha e merito defasados
. * =====================================================================================
. capture program drop setcmd

. program define setcmd, eclass
  1.     ereturn local cmd "`1'"
  2. end

. tempname T

. postfile `T' str20 m double(b_lo b_hi thr pboot) long(N T nmom) using "$RINT/h3_threshold.dta", replace

. foreach win in "2015 2019" "2000 2019" {
  2.     use "$RINT/anual_rv.dta", clear
  3.     keep if micro == 0
  4.     xtset id year
  5.     gen wb_l1 = L.wb
  6.     local y0 : word 1 of `win'
  7.     local y1 : word 2 of `win'
  8.     keep if inrange(year, `y0', `y1')
  9.     gen byte ok = !missing(g, wb_l1, merit_l1)
 10.     bysort id: egen nok = total(ok)
 11.     keep if nok == `y1' - `y0' + 1
 12.     quietly levelsof id
 13.     local Nbal : word count `r(levels)'
 14.     local TT = `y1' - `y0' + 1
 15.     local L = 0
 16.     forvalues t = 3/`TT' {
 17.         local L = `L' + 1 + (`t' - 2) + 1
 18.     }
 19.     xtset id year
 20.     set seed 20261017
 21.     capture noisily xthenreg g merit_l1 wb_l1, boost(500) grid_num(100) trim_rate(0.4)
 22.     if !_rc {
 23.         local k = colnumb(e(b), "wb_l1_b")
 24.         local kd = colnumb(e(b), "wb_l1_d")
 25.         post `T' ("seoshin_`y0'") (el(e(b), 1, `k')) (el(e(b), 1, `k') + el(e(b), 1, `kd')) (el(e(b), 1, colnumb(e(b), "r"))) (e(boots_p)) (`Nbal') (`TT') (`L')
 26.         rv_kv thr_ss_`y0'_p `=string(e(boots_p), "%6.3f")'
 27.         rv_kv thr_ss_`y0'_valid `=cond(`L' < `Nbal' / 2, "yes", "no")'
 28.     }
 29.     if `y0' == 2000 {
 30.         quietly tab year, gen(yd)
 31.         drop yd1
 32.         capture noisily xthreg g yd*, rx(wb_l1) qx(merit_l1) thnum(1) trim(0.10) grid(300) bs(500)
 33.         if !_rc {
 34.             matrix FH = e(Fstat)
 35.             matrix TH = e(Thrss)
 36.             local hn : colnames e(b)
 37.             local b1 = .
 38.             local b2 = .
 39.             local kk = 0
 40.             foreach nm of local hn {
 41.                 local ++kk
 42.                 if strpos("`nm'", "wb_l1") == 0 continue
 43.                 if missing(`b1') local b1 = el(e(b), 1, `kk')
 44.                 else local b2 = el(e(b), 1, `kk')
 45.             }
 46.             post `T' ("hansen_2000") (`b1') (`b2') (TH[1, 1]) (FH[1, 4]) (`Nbal') (`TT') (0)
 47.             rv_kv thr_hansen_p `=string(FH[1, 4], "%6.3f")'
 48.         }
 49.         * P21: o mesmo painel balanceado, modelo linear sem limiar (com e sem os controles e o crescimento defasado da Tabela 1)
.         xtreg g wb_l1 yd*, fe vce(cluster id)
 50.         rv_kv thr_lin_static `=string(_b[wb_l1], "%9.4f")'
 51.         gen g_l1 = L.g
 52.         gen lny_l1 = L.lny
 53.         xtreg g wb_l1 g_l1 lny_l1 hc inv open infl popg ctot_g yd*, fe vce(cluster id)
 54.         rv_kv thr_lin_controls `=string(_b[wb_l1], "%9.4f")'
 55.         rv_kv thr_lin_N `e(N)'
 56.     }
 57. }
