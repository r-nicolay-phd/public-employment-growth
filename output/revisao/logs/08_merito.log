. 
. * ---------------------------------------------------------------- kernel (interflex), com bootstrap por pais
. preserve

. keep if sM
(1,162 observations deleted)

. * O kernel do interflex falha com efeitos fixos (bootstrap devolve ICs ausentes e a rotina grafica quebra) e nao
. * converge com as dummies como covariaveis; por isso o kernel e implementado aqui: regressao local-linear com
. * nucleo gaussiano, largura de banda escolhida pela validacao cruzada do interflex (0,49), efeitos fixos de pais e
. * periodo, 25 pontos entre os percentis 5 e 95 do merito e bootstrap por pais (200 replicacoes).
. local bw = 0.4897

. _pctile meritc, p(5 95)

. local e0 = r(r1)

. local e1 = r(r2)

. tempname K

. postfile `K' double(zk mek lok hik) using "$RINT/h3_kernel.dta", replace

. tempfile base

. save `base'
file C:\Users\Usuario\AppData\Local\Temp\ST_64e0_000002.tmp saved as .dta format

. forvalues j = 1/25 {
  2.     local z0 = `e0' + (`e1' - `e0') * (`j' - 1) / 24
  3.     quietly use `base', clear
  4.     quietly gen double kw = normalden((meritc - `z0') / `bw')
  5.     quietly gen double zd = meritc - `z0'
  6.     quietly gen double dzd = wb_m1 * zd
  7.     quietly reghdfe g wb_m1 zd dzd $XP i.period [aw = kw], absorb(id)
  8.     local me0 = _b[wb_m1]
  9.     tempname R
 10.     tempfile rr
 11.     postfile `R' double me using `rr', replace
 12.     set seed 20261017
 13.     forvalues r = 1/200 {
 14.         quietly use `base', clear
 15.         quietly bsample, cluster(id) idcluster(bid)
 16.         quietly gen double kw = normalden((meritc - `z0') / `bw')
 17.         quietly gen double zd = meritc - `z0'
 18.         quietly gen double dzd = wb_m1 * zd
 19.         capture quietly reghdfe g wb_m1 zd dzd $XP i.period [aw = kw], absorb(bid)
 20.         if !_rc post `R' (_b[wb_m1])
 21.     }
 22.     postclose `R'
 23.     quietly use `rr', clear
 24.     quietly _pctile me, p(2.5 97.5)
 25.     post `K' (`z0' + `mbar') (`me0') (r(r1)) (r(r2))
 26. }
