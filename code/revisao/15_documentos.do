* 15_documentos.do -- Tabela S1 (fontes, definicoes e limpeza), output/revisao/captions.md,
* output/revisao/MAPA_NUMERACAO.md e docs/PACOTES_STATA.md
version 17
if "$ROOT" == "" global ROOT "`c(pwd)'"
do "$ROOT/code/revisao/00_setup.do"
capture log close
log using "$RLOG/15_documentos.log", replace text

capture program drop kvload
program define kvload
    preserve
    import delimited "$RINT/kv.csv", clear varnames(1) stringcols(_all)
    gen long n = _n
    bysort key (n): keep if _n == _N
    forvalues i = 1/`=_N' {
        c_local KV_`=key[`i']' "`=value[`i']'"
    }
    restore
end
kvload

* =====================================================================================
* Tabela S1: fontes, definicoes e regras de limpeza
* =====================================================================================
rv_new, ncol(2) head1("Definition and source" "Notes")
rv_row "A. Variables" "" ""
rv_row "Wage bill, general government" "Compensation of employees (GFSM 2014, code 21), % of GDP; IMF Government Finance Statistics" "Main regressor"
rv_row "Wage bill, central government" "Compensation of employees (% of expense) × expense (% of GDP) / 100; WDI" "Coverage comparison"
rv_row "Trend GDP" "Trend of log real GDP: Hamilton (H = 2, k = 2), one-sided HP and two-sided HP (lambda = 6.25)" "Denominator corrections"
rv_row "Real wage bill shock" "100 × (W_t/P_t − W_(t−1)/P_(t−1)) / y_(t−1), P = GDP deflator, y = real GDP" "Local projections"
rv_row "Public employment, relative wage, premium" "WWBI (World Bank); relative wage = wage bill / public employment share" "Decomposition"
rv_row "Meritocratic recruitment" "V-Dem v16, v2stcritrecadm (higher = more merit-based)" "H3"
rv_row "Institutions" "WGI (six indicators); ICRG quality of government (QoG)" "Replications"
rv_row "Elections, ideology, competitiveness" "DPI 2020: predetermined election, execrlc, maj, frac" "H5 and extensions"
rv_row "Democracy, clientelism, impartiality" "V-Dem v16: v2x_polyarchy, v2dlencmps, v2clrspct" "H5 and extensions"
rv_row "Union density" "ILOSTAT, ILR_TUMT_NOC_RT" "Extensions"
rv_row "Banking crises" "Laeven and Valencia (2018), start to end year, to 2017" "Structural checks"
rv_row "Health and education spending" "IMF GFS COFOG, general government, GF07 + GF09 (% of total outlays); WDI as declared substitute" "Structural checks"
rv_row "Executive constraints" "Polity5, xconst (1–7), 1946–2018" "Replication (exploratory)"
rv_row "Replication of Mollick and Vianna" "WDI NY.GDP.MKTP.KD.ZG, NE.CON.GOVT.ZS, NE.GDI.TOTL.ZS (13 November 2026); WGI GE, CC, RL" "Replication (exploratory)"
rv_row "Narrative wage-bill consolidations" "Alesina, Favero and Giavazzi (2019), Spending – Salaries" "Exogenous variation"
rv_row "Growth, controls" "WDI, Penn World Table 11.0, IMF ICSD, IMF commodity terms of trade, IMF Global Debt Database" ""
rv_mid
rv_row "B. Cleaning rules (non-microstate country-years, 1979–2023)" "Rule" "Observations affected"
rv_row "Conventional" "Wage bill above 30% or expenditure above 100% of GDP set to missing; growth and inflation winsorized at p1/p99; microstates (population below 500,000) excluded" "See docs/AUDITORIA_DADOS.md"
rv_row "Extended" "Revenue above 100% of GDP set to missing" "`KV_clean_rev'"
rv_row "Extended" "Fiscal balance outside ±50% of GDP set to missing" "`KV_clean_bal'"
rv_row "Extended" "Inflation above 1,000% set to missing" "`KV_clean_infl'"
rv_row "Extended" "Openness equal to zero set to missing" "`KV_clean_open'"
rv_row "Extended" "Expenditure shares outside [0, 100] set to missing" "`KV_clean_shares'"
rv_out TabS1_data_cleaning, landscape ///
    title("Table S1. Data sources, definitions and cleaning rules") ///
    notes("Full variable definitions and download dates in the replication README and data/raw/*/_SOURCE.txt. The extended cleaning rules leave the five-year baseline sample unchanged (`KV_S5_base_N' country-periods) but change one influential value (Bulgaria, 1997 inflation), which moves the conventional-specification coefficient.")

* =====================================================================================
* captions.md: tabelas (dos arquivos gravados por rv_out) e figuras (definidas aqui)
* =====================================================================================
kvload
tempname C
file open `C' using "$ROOT/output/revisao/captions.md", write replace text
file write `C' "# Captions" _n _n
file write `C' "Generated by \`code/revisao/15_documentos.do\`. Table captions are identical to those in \`output/revisao/tables/\`; numbers come from the estimation files." _n _n
file write `C' "## Tables" _n _n
foreach t in Tab1_measures Tab2_timing Tab3_baseline_composition Tab4_coverage Tab5_decomposition Tab6_replications Tab7_political_economy Tab8_robustness_map ///
    TabS1_data_cleaning TabS2_descriptives TabS_bias_decomposition TabS_lags_leads TabS_gg_cg_ratio TabS_decomposition_bias TabS_cyclicality ///
    TabS_structural TabS_moderation TabS_exogenous TabS_bond_longrun TabS_mechanisms TabS_inference_summary TabS_lp_horizons TabS_bma TabS16_countries TabS_mv_faithful TabS_opra_xconst {
    capture confirm file "$RCAP/`t'.txt"
    if _rc continue
    tempname I
    file open `I' using "$RCAP/`t'.txt", read text
    file read `I' l1
    file read `I' l2
    file close `I'
    file write `C' "**`macval(l1)'**" _n _n "*Notes:* `macval(l2)'" _n _n "File: \`output/revisao/tables/`t'.{tex,docx}\`" _n _n
}
file write `C' "## Figures" _n _n
file write `C' "**Figure 1. General government wage bill by income group, 1996–2023.** *Notes:* Median across countries of compensation of employees of the general government (% of GDP, IMF GFS), by World Bank income group in 1996; number of countries in parentheses (low `KV_fig1_n1', lower middle `KV_fig1_n2', upper middle `KV_fig1_n3', high `KV_fig1_n4'); microstates excluded. The set of countries with data changes over time (Figure S1). File: \`Fig1_wagebill_income\`." _n _n
file write `C' "**Figure 2. The wage bill coefficient under different measures of the wage bill.** *Notes:* Coefficients and 95% confidence intervals of Table 1. Annual panel (circles): same sample and model, Driscoll-Kraay standard errors. Five-year panel (diamonds): same sample, clustered standard errors. The one-sided HP filter uses only data up to t; the Hamilton filter is predetermined. Tested differences in Table 1. File: \`Fig2_measures\`." _n _n
file write `C' "**Figure 3. Timing of the initial wage bill.** *Notes:* Coefficients and 95% confidence intervals of Table 2 (columns 1–6), in each specification's own sample (circles) and in the conventional-specification sample (diamonds). File: \`Fig3_timing\`." _n _n
file write `C' "**Figure 4. Institutions and government size: replications.** *Notes:* Interaction between government consumption and institutional quality (95% confidence intervals) in the replication of Oto-Peralías and Romero-Ávila (2013) with the ICRG quality-of-government index (1981–2005) and with WGI government effectiveness (1996–2020), in the approximate replication of Mollick and Vianna registered in the plan (WGI mean, consumption in % of GDP) and in the exploratory replication with their published specification (WGI government effectiveness, log consumption; Table S17); only the measure of government consumption changes within each group. Scales of the institutional indices and of consumption differ across groups. Table 6. File: \`Fig4_reconciliation\`." _n _n
file write `C' "**Figure 5. Public employment and relative public pay across countries.** *Notes:* Country means over 2000–2023 (WWBI years), `KV_fig5_nc' countries; correlation `KV_fig5_corr'. Horizontal axis: public employment (% of total employment, WWBI). Vertical axis: general government wage bill per public employee divided by GDP per worker. Markers by 1996 income group. Labelled countries chosen as references. File: \`Fig5_employment_relwage\`." _n _n
file write `C' "**Figure 6. Marginal effect of the wage bill on growth across meritocratic recruitment.** *Notes:* Five-year averages, wage bill and merit in t_p − 1, predetermined controls, country and period fixed effects (`KV_h3_N' country-periods). Solid line and band: linear interaction with 95% confidence interval (clustered). Dashed line: local-linear kernel estimator (Gaussian kernel, bandwidth 0.49) with 95% country-bootstrap interval (dotted, 200 replications). Diamonds: tercile-bin estimates of Hainmueller, Mummolo and Xu (2019). Lower panel: distribution of merit in the estimation sample. Higher values = more merit-based. File: \`Fig6_marginal_merit\`." _n _n
file write `C' "**Figure 7. Local projections: wage bill shock with leads and predetermined wage bill level.** *Notes:* Annual panel 1996–2023, country and year fixed effects, Driscoll-Kraay 95% bands (maximum lag 3). (a) Cumulative response of 100 × log GDP per capita from t − 1 to t + h to a real wage bill shock of one percentage point of lagged GDP, with two lags of the shock and of growth; negative horizons are leads (h = −1 is the normalisation). (b) Response to the predetermined level of the wage bill in t − 1, divided by trend GDP (Hamilton), with two lags of growth. File: \`Fig7_lp_level_leads\`." _n _n
file write `C' "**Figure 8. Response of GDP per capita by merit regime.** *Notes:* Local projections as in Figure 7(a), with the shock interacted with merit above the median in the year before the shock (V-Dem); 95% Driscoll-Kraay intervals. At h = 5 the high-merit estimate rests on `KV_lpm_base_h5_nep' shock episodes in `KV_lpm_base_h5_nc' countries. Romano-Wolf adjusted p-values by horizon in Table S14. File: \`Fig8_lp_merit\`." _n _n
file write `C' "**Figure 9. Specification curve of the wage bill coefficient.** *Notes:* `KV_sc_n' specifications combining the measure (t_p, t_p − 1, t_p − 1 over trend GDP), controls (period means, predetermined, predetermined without investment), frequency (five and three years), sample (baseline, with microstates, without banking-crisis periods, from 1994) and fixed effects (country and period; plus country trends; plus region × period). Upper panel: coefficients ranked, with 95% confidence intervals (clustered); filled markers have intervals below zero (`KV_sc_negsig' of `KV_sc_n'). Lower panel: choices of each specification. File: \`Fig9_specification_curve\`." _n _n
file write `C' "**Figure S1. Data coverage.** *Notes:* Number of non-microstate countries with each series by year. File: \`FigS1_coverage\`." _n _n
file write `C' "**Figure S2. Structural and crisis explanations.** *Notes:* Coefficient on the wage bill in t_p − 1 in the preferred specification with each change of Table S8; 95% confidence intervals. File: \`FigS_structural\`." _n _n
file write `C' "**Figure S3. Narrative wage-bill consolidations.** *Notes:* Local projections of Table S10; Driscoll-Kraay 95% bands. File: \`FigS_exogenous\`." _n _n
file write `C' "**Figure S4. Binning estimator of Hainmueller, Mummolo and Xu (interflex).** *Notes:* Output of the interflex binning estimator with country and period fixed effects and clustered errors (three bins); Wald test of linearity reported in the figure. File: \`FigS_interflex_binning\`." _n _n
file close `C'

