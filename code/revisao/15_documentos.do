* =====================================================================================
* PACOTES_STATA.md: pacotes e versoes (stata.trk de ado/plus)
* =====================================================================================
tempname T O
file open `T' using "$ROOT/ado/plus/stata.trk", read text
file open `O' using "$DOCS/PACOTES_STATA.md", write replace text
file write `O' "# Stata packages used" _n _n
file write `O' "Stata 17 (StataMP). Community-contributed packages installed in \`ado/plus\` by \`code/revisao/00_instala.do\`; list read from \`ado/plus/stata.trk\` by \`code/revisao/15_documentos.do\`. Packages that could not be installed from the author's source were copied from the package folder of the earlier pipeline (\`code/ado/plus\`): xthenreg, xthreg, bma and wals." _n _n
file write `O' "| Package | Source | Distribution date | Installed |" _n "|---|---|---|---|" _n
local pkg ""
local src ""
local dd ""
local inst ""
file read `T' line
while r(eof) == 0 {
    local c = substr(`"`macval(line)'"', 1, 2)
    if "`c'" == "S " local src = substr(`"`macval(line)'"', 3, .)
    if "`c'" == "N " local pkg = subinstr(substr(`"`macval(line)'"', 3, .), ".pkg", "", .)
    if "`c'" == "D " local inst = substr(`"`macval(line)'"', 3, .)
    if strpos(`"`macval(line)'"', "Distribution-Date") local dd = strtrim(substr(`"`macval(line)'"', strpos(`"`macval(line)'"', ":") + 1, .))
    if "`c'" == "e" | `"`macval(line)'"' == "e" {
        if "`pkg'" != "" file write `O' "| `pkg' | `src' | `dd' | `inst' |" _n
        local pkg ""
        local dd ""
        local inst ""
    }
    file read `T' line
}
file close `T'
file close `O'

log close
